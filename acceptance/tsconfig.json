{
  "extends": "@sweatpants/ts-config/tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "noEmit": true,
    "customConditions": ["development"],
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": [
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    "fixtures/**/*.ts",
    "fixtures/**/*.tsx",
    "support/**/*.ts",
    "support/**/*.tsx",
    "vitest.config.ts"
  ],
  "exclude": ["__tests__/tool-runtimes/cloudflare/fixtures/**"]
}
