{
  "name": "@sweatpants/acceptance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --conditions=development\" vitest run",
    "test:watch": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --conditions=development\" vitest",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.cloudflare.json",
    "lint": "cd .. && oxlint --type-aware acceptance",
    "lint:fix": "cd .. && oxlint --type-aware acceptance --fix",
    "format": "cd .. && oxfmt acceptance",
    "format:check": "cd .. && oxfmt acceptance --check",
    "build:clean": "tsx ../scripts/clean-build.ts ."
  },
