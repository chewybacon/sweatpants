{
  "name": "storage-inspector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "build": "vite build",
    "test": "vitest run --passWithNoTests",
    "lint": "cd ../.. && oxlint --type-aware apps/storage-inspector",
    "lint:fix": "cd ../.. && oxlint --type-aware apps/storage-inspector --fix",
    "format": "cd ../.. && oxfmt apps/storage-inspector",
    "format:check": "cd ../.. && oxfmt apps/storage-inspector --check",
    "build:clean": "tsx ../../scripts/clean-build.ts ."
  },
  "dependencies": {
    "@sweatpants/storage-sqlite": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@sweatpants/foundation": "workspace:*",
    "@sweatpants/ts-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "drizzle-orm": "catalog:",
    "effection": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
