---
import "../styles/global.css";
import { SiteChrome } from "../design-system/SiteChrome.tsx";

const { title = "yo-tisyn", description = "Durable workflows authored as Tisyn programs." } = Astro.props;
const pathname = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#191724" />
    <link rel="icon" href="data:," />
    {import.meta.env.DEV && <link rel="stylesheet" href="/virtual:stylex.css" />}
    {import.meta.env.DEV && <script is:inline type="module" src="/@id/virtual:stylex:runtime"></script>}
    <title>{title}</title>
  </head>
  <body>
    <SiteChrome pathname={pathname}>
      <slot />
    </SiteChrome>
  </body>
</html>
