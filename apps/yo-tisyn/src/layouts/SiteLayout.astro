---
import "../styles/global.css";
import { env } from "cloudflare:workers";
import { reasoningLevel } from "../server/model-settings.ts";
import { SiteChrome } from "../design-system/SiteChrome.tsx";

const { title = "yo-tisyn", description = "Durable workflows authored as Tisyn programs." } = Astro.props;
const pathname = Astro.url.pathname;
const bindings = env as { DEFAULT_CHAT_MODEL_PROVIDER?: string; DEFAULT_CHAT_MODEL_ID?: string; DEFAULT_CHAT_MODEL_THINKING?: string };
const modelLabel = bindings.DEFAULT_CHAT_MODEL_ID
  ? `${bindings.DEFAULT_CHAT_MODEL_PROVIDER} · ${bindings.DEFAULT_CHAT_MODEL_ID} · ${reasoningLevel(bindings.DEFAULT_CHAT_MODEL_THINKING)}`
  : "yo-tisyn";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#191724" />
    <link rel="icon" href="data:," />
    {import.meta.env.DEV && <link rel="stylesheet" href="/virtual:stylex.css" />}
    {import.meta.env.DEV && <script is:inline type="module" src="/@id/virtual:stylex:runtime"></script>}
    <title>{title}</title>
  </head>
  <body>
    <SiteChrome pathname={pathname} modelLabel={modelLabel}>
      <slot />
    </SiteChrome>
  </body>
</html>
