{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "yo-chat",
    "main": "src/server.cloudflare.ts",
    "compatibility_date": "2026-10-05",
    "compatibility_flags": ["nodejs_compat"],
    "durable_objects": {
        "bindings": [
            { "name": "TOOL_EXECUTORS", "class_name": "ToolExecutors" },
            {
                "name": "RESPONSE_STREAMS",
                "class_name": "ResponseStream",
            },
            {
                "name": "TOOL_SESSIONS",
                "class_name": "ToolSessions",
            },
        ],
    },
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": ["ResponseStream", "ToolSessions"],
        },
        { "tag": "v2", "new_sqlite_classes": ["ToolExecutors"] },
    ],
    "d1_databases": [
        {
            "binding": "JOURNAL",
            "database_name": "yo-chat-worker-journal",
            "database_id": "267d8420-c4b3-4b15-94ee-412bd42b5326",
        },
        {
            "binding": "THREAD_METADATA",
            "database_name": "yo-chat-worker-metadata",
            "database_id": "16a43a25-6887-4dad-b21a-686abef4a947",
        },
    ],
    "secrets": {
        "required": [
            "MODEL_CREDENTIALS",
            "PROGRAM_DRIVER_CAPABILITY_SECRET",
            "DEFAULT_CHAT_MODEL_PROVIDER",
            "DEFAULT_CHAT_MODEL_ID",
        ],
    },
}
