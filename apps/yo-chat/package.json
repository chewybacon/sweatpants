{
    "name": "yo-chat",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite dev --port 8000",
        "generate:tools": "tsx scripts/generate-tools.ts",
        "verify:generated": "tsx scripts/verify-generated.ts",
        "check": "tsc --noEmit",
        "build": "vite build && pnpm run build:server",
        "build:server": "esbuild express-server.ts --bundle --platform=node --format=esm --outfile=dist/express-server.js --packages=external --external:./server/*",
        "preview": "vite preview",
        "test": "vitest run",
        "test:acceptance": "vitest run acceptance",
        "test:acceptance:external": "vitest run --config vitest.external-acceptance.config.ts",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:outside-in": "RUN_LIVE=1 OUTSIDE_IN_TIER_B=1 OUTSIDE_IN_ATTEMPTS=1 OUTSIDE_IN_TIMEOUT_MS=80000 OUTSIDE_IN_TEST_TIMEOUT_MS=85000 vitest run --config vitest.outside-in.config.ts --bail=1",
        "test:outside-in:tier-a": "RUN_LIVE=1 OUTSIDE_IN_ATTEMPTS=1 OUTSIDE_IN_TIMEOUT_MS=80000 OUTSIDE_IN_TEST_TIMEOUT_MS=85000 vitest run --config vitest.outside-in.config.ts --bail=1",
        "test:outside-in:hermetic": "RUN_LIVE=0 vitest run --config vitest.outside-in.config.ts src/outside-in/worker-boundary.test.ts --bail=1",
        "deploy": "vite build",
        "server": "node dist/express-server.js",
        "server:dev": "tsx express-server.ts"
    },
    "dependencies": {
        "@effectionx/context-api": "catalog:",
        "@radix-ui/react-avatar": "^1.1.11",
        "@radix-ui/react-collapsible": "^1.1.12",
        "@radix-ui/react-scroll-area": "^1.2.10",
        "@radix-ui/react-slot": "^1.2.4",
        "@sweatpants/core": "workspace:*",
        "@sweatpants/crank-store-redis": "workspace:*",
        "@sweatpants/durable-streams": "workspace:*",
        "@sweatpants/framework": "workspace:*",
        "@sweatpants/model-provider-pi-ai": "workspace:*",
        "@sweatpants/react-chat": "workspace:*",
        "@sweatpants/session-contract": "workspace:*",
        "@sweatpants/stream-bridge": "workspace:*",
        "@sweatpants/tool-runtime-agentcore": "workspace:*",
        "@sweatpants/tool-runtime-local": "workspace:*",
        "@sweatpants/vite-plugin": "workspace:*",
        "@t3-oss/env-core": "catalog:",
        "@tailwindcss/vite": "catalog:",
        "@tanstack/react-devtools": "catalog:",
        "@tanstack/react-router": "catalog:",
        "@tanstack/react-router-devtools": "catalog:",
        "@tanstack/react-router-ssr-query": "catalog:",
        "@tanstack/react-start": "catalog:",
        "@tanstack/router-plugin": "catalog:",
        "@types/katex": "^0.16.7",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "compression": "catalog:",
        "effection": "catalog:",
        "express": "catalog:",
        "katex": "^0.16.27",
        "lucide-react": "catalog:",
        "marked": "^17.0.1",
        "mermaid": "^11.12.2",
        "morgan": "catalog:",
        "nitro": "latest",
