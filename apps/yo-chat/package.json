{
  "name": "yo-chat",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx ../../scripts/dev-yo-chat.ts",
    "check": "tsc --noEmit",
    "build": "vite build && pnpm run build:server",
    "build:server": "esbuild express-server.ts --bundle --platform=node --format=esm --outfile=dist/express-server.js --packages=external --external:./server/*",
    "preview": "vite preview",
    "test": "vitest run",
    "test:acceptance": "vitest run acceptance",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:manual": "E2E_FULL=1 playwright test",
    "test:e2e:manual:ui": "E2E_FULL=1 playwright test --ui",
    "deploy": "vite build",
    "server": "node dist/express-server.js",
    "server:dev": "tsx express-server.ts",
    "dev:metadata": "wrangler dev --config wrangler.metadata.jsonc --port 8788",
    "metadata:init:local": "wrangler d1 execute THREAD_METADATA --local --config wrangler.metadata.jsonc --file schema/thread-metadata.sql",
    "task": "tsx ../../scripts/dev-app.ts yo-chat cf-task --config wrangler.tasks.jsonc --persist-to .wrangler/worker-state",
    "lint": "cd ../.. && oxlint --type-aware apps/yo-chat",
    "lint:fix": "cd ../.. && oxlint --type-aware apps/yo-chat --fix",
    "format": "cd ../.. && oxfmt apps/yo-chat",
    "format:check": "cd ../.. && oxfmt apps/yo-chat --check",
    "build:clean": "tsx ../../scripts/clean-build.ts .",
    "dev:local": "MCP_TOOL_RUNTIME=local pnpm dev",
    "dev:profile": "node ../../scripts/profiling/yo-chat.mjs",
    "test:e2e:provider": "tsx ../../scripts/yo-chat-e2e.ts"
  },
  "dependencies": {
    "@ag-ui/core": "1.0.1",
