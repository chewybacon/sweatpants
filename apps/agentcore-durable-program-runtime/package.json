{
  "name": "@sweatpants/agentcore-durable-program-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build:image": "./scripts/build-image.sh",
    "deploy:agentcore": "tsx scripts/deploy-agentcore-runtime.ts",
    "smoke:websocket": "tsx scripts/smoke-websocket.ts",
    "certify:live": "tsx scripts/certify-live.ts",
    "certify:workflow-host": "tsx scripts/certify-workflow-host.ts",
    "certify:development-readiness": "tsx scripts/certify-development-readiness.ts",
    "certify:development-play-ttt": "tsx scripts/certify-development-play-ttt.ts",
    "lint": "cd ../.. && oxlint --type-aware apps/agentcore-durable-program-runtime",
    "lint:fix": "cd ../.. && oxlint --type-aware apps/agentcore-durable-program-runtime --fix",
    "format": "cd ../.. && oxfmt apps/agentcore-durable-program-runtime",
    "format:check": "cd ../.. && oxfmt apps/agentcore-durable-program-runtime --check",
    "build:clean": "tsx ../../scripts/clean-build.ts ."
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.996.0",
    "@aws-sdk/client-bedrock-agentcore-control": "^3.996.0",
    "@aws-sdk/client-s3": "^3.996.0",
    "@sweatpants/cli": "workspace:*",
    "@sweatpants/durable-effects": "workspace:*",
    "@sweatpants/durable-execution": "workspace:*",
    "@sweatpants/foundation": "workspace:*",
    "@sweatpants/journal-authority": "workspace:*",
    "@sweatpants/model-sampling": "workspace:*",
    "@sweatpants/tool-runtime-agentcore": "workspace:*",
    "effection": "catalog:",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@sweatpants/ts-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yo-chat": "workspace:*"
  }
}
