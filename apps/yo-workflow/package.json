{
  "name": "yo-workflow",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#scheme-kernel-wasm": "@sweatpants/flowmode-runtime-scheme/kernel.wasm",
    "#scheme-reflect-wasm": "@sweatpants/flowmode-runtime-scheme/reflect.wasm",
    "#scheme-wtf8-wasm": "@sweatpants/flowmode-runtime-scheme/wtf8.wasm"
  },
  "scripts": {
    "dev": "tsx scripts/dev-cloudflare.ts",
    "dev:server": "NODE_OPTIONS=--conditions=development tsx src/server/node.ts",
    "check": "pnpm scheme:check && astro-check && tsc --noEmit",
    "test": "pnpm scheme:check && vitest run",
    "build": "pnpm scheme:check && astro build",
    "build:cloudflare": "pnpm scheme:check && astro build",
    "build:deploy": "CLOUDFLARE_ENV=production pnpm build:cloudflare",
    "deploy:prepare": "tsx scripts/prepare-deployment.ts && tsx scripts/prepare-cloudflare.ts --remote",
    "deploy": "pnpm build:deploy && wrangler deploy --config dist/server/wrangler.json --secrets-file .wrangler/deployment-secrets.json",
    "astro": "astro",
    "dev:cloudflare": "tsx scripts/dev-cloudflare.ts",
    "verify:reasoning": "NODE_OPTIONS=--conditions=development tsx scripts/verify-reasoning.ts",
    "scheme:build": "pnpm --filter @sweatpants/flowmode-runtime-scheme wasm:build",
    "scheme:check": "pnpm --filter @sweatpants/flowmode-runtime-scheme wasm:check",
    "execution:lua:build": "pnpm --filter @sweatpants/flowmode-runtime-lua wasm:build",
    "execution:build": "pnpm --filter @sweatpants/flowmode-runtime-scheme execution:build",
    "execution:test": "pnpm execution:compile && node execution/__tests__/service.mjs && node execution/__tests__/failure.mjs && node execution/__tests__/recompile.mjs",
    "execution:compile": "tsdown --config ../../experiments/workflow-kernel/tsdown-authoring/tsdown.config.mjs",
    "execution:dev": "pnpm dev",
    "lint": "cd ../.. && oxlint --type-aware apps/yo-workflow",
    "lint:fix": "cd ../.. && oxlint --type-aware apps/yo-workflow --fix",
    "format": "cd ../.. && oxfmt apps/yo-workflow",
    "format:check": "cd ../.. && oxfmt apps/yo-workflow --check",
    "build:clean": "tsx ../../scripts/clean-build.ts ."
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@earendil-works/pi-ai": "1.0.1",
    "@stylexjs/stylex": "0.19.1",
    "@sweatpants/agent-host": "workspace:*",
    "@sweatpants/agent-sdk": "workspace:*",
    "@sweatpants/chat-contract": "workspace:*",
    "@sweatpants/chat-core": "workspace:*",
    "@sweatpants/durable-chat-runtime": "workspace:*",
    "@sweatpants/durable-effects": "workspace:*",
    "@sweatpants/durable-execution": "workspace:*",
    "@sweatpants/durable-streams-cloudflare": "workspace:*",
    "@sweatpants/flowmode-backend": "workspace:*",
    "@sweatpants/flowmode-runtime": "workspace:*",
    "@sweatpants/flowmode-runtime-lua": "workspace:*",
    "@sweatpants/flowmode-runtime-scheme": "workspace:*",
    "@sweatpants/foundation": "workspace:*",
    "@sweatpants/frame-renderer": "workspace:*",
    "@sweatpants/journal-authority": "workspace:*",
    "@sweatpants/model-decision": "workspace:*",
    "@sweatpants/model-provider-pi-ai": "workspace:*",
    "@sweatpants/react-chat": "workspace:*",
    "@sweatpants/storage-d1": "workspace:*",
    "@sweatpants/stream-bridge": "workspace:*",
    "@sweatpants/tool-runtime": "workspace:*",
    "@sweatpants/tool-runtime-cloudflare": "workspace:*",
    "@sweatpants/vite-plugin": "workspace:*",
    "@xyflow/react": "^12.12.0",
    "effection": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/cloudflare": "14.3.4",
    "@astrojs/react": "7.0.1",
    "@cloudflare/workers-types": "5.20261005.1",
    "@stylexjs/unplugin": "0.19.1",
    "@sweatpants/cloudflare-tasks": "workspace:*",
    "@sweatpants/flowmode-compiler": "workspace:*",
    "@sweatpants/flowmode-compiler-lua": "workspace:*",
    "@sweatpants/flowmode-compiler-scheme": "workspace:*",
    "@sweatpants/test-rig": "workspace:*",
    "@sweatpants/ts-config": "workspace:*",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "astro": "7.3.8",
    "esbuild": "^0.24.0",
    "jsdom": "catalog:",
    "miniflare": "5.20261001.0-alpha",
    "oxc-transform-react": "0.145.0",
    "tsdown": "0.23.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.147.0"
  }
}
