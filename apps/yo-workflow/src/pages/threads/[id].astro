---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { App } from "../../chat/App.tsx";
import { Button } from "../../design-system/primitives.tsx";

export const prerender = false;
const threadId = Astro.params.id;
if (!threadId || !/^[a-f0-9-]{16,64}$/i.test(threadId)) {
  return Astro.redirect("/threads");
}
---
<SiteLayout title={`Thread ${threadId.slice(0, 8)} · yo-workflow`} description="Resume a durable yo-workflow workflow.">
  <section class="page-intro compact">
    <span class="eyebrow">Playground / durable thread</span>
    <div class="thread-intro-heading">
      <h1>Your workflow</h1>
      <Button href="/playground" variant="outline">New thread ＋</Button>
    </div>
    <p>Choose a starting point or describe a task. Your replies and accepted work stay with this thread.</p>
  </section>
  <App client:only="react" initialThreadId={threadId}>
    <p slot="fallback" class="hint" role="status">Opening your thread…</p>
  </App>
</SiteLayout>
