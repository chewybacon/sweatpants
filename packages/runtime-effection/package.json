  },
  "dependencies": {
    "@sweatpants/foundation": "workspace:*",
    "effection": "catalog:"
  },
  "devDependencies": {
    "@sweatpants/ts-config": "workspace:*",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
