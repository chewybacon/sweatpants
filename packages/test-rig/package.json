{
  "name": "@sweatpants/test-rig",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": {
        "import": "./src/index.ts",
        "types": "./src/index.ts"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./ag-ui": {
      "development": {
        "import": "./src/ag-ui.ts",
        "types": "./src/ag-ui.ts"
      },
      "import": {
        "types": "./dist/ag-ui.d.ts",
        "default": "./dist/ag-ui.js"
      }
    },
    "./model": {
      "development": {
        "import": "./src/model.ts",
        "types": "./src/model.ts"
      },
      "import": {
        "types": "./dist/model.d.ts",
        "default": "./dist/model.js"
      }
    },
    "./chat": {
      "development": {
        "import": "./src/chat.ts",
        "types": "./src/chat.ts"
      },
      "import": {
        "types": "./dist/chat.d.ts",
        "default": "./dist/chat.js"
      }
    },
    "./history": {
      "development": {
        "import": "./src/history.ts",
        "types": "./src/history.ts"
      },
      "import": {
        "types": "./dist/history.d.ts",
        "default": "./dist/history.js"
      }
    },
    "./scenario": {
      "development": {
        "import": "./src/scenario.ts",
        "types": "./src/scenario.ts"
      },
      "import": {
        "types": "./dist/scenario.d.ts",
        "default": "./dist/scenario.js"
      }
    }
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --noEmit false --outDir dist --rootDir src",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "cd ../.. && oxlint --type-aware packages/test-rig",
    "test": "vitest run",
    "lint:fix": "cd ../.. && oxlint --type-aware packages/test-rig --fix",
    "format": "cd ../.. && oxfmt packages/test-rig",
    "format:check": "cd ../.. && oxfmt packages/test-rig --check",
    "build:clean": "tsx ../../scripts/clean-build.ts ."
  },
  "dependencies": {
    "@simulacrum/foundation-simulator": "0.8.0",
    "@sweatpants/chat-client": "workspace:*",
    "@sweatpants/foundation": "workspace:*",
    "@sweatpants/model-provider": "workspace:*",
    "@sweatpants/model-provider-pi-ai": "workspace:*",
    "@sweatpants/tool-session": "workspace:*",
    "effection": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ag-ui/core": "1.0.1",
    "@sweatpants/ts-config": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
