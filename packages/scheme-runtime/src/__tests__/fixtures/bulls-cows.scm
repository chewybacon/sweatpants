(let ()
  (define (digits n)
    (list (quotient n 1000) (remainder (quotient n 100) 10) (remainder (quotient n 10) 10) (remainder n 10)))
  (define (member-digit? d lst)
    (cond ((null? lst) #f) ((= d (car lst)) #t) (else (member-digit? d (cdr lst)))))
  (define (distinct-digits? ds)
    (cond ((null? ds) #t) ((member-digit? (car ds) (cdr ds)) #f) (else (distinct-digits? (cdr ds)))))
  (define (bulls-of g c)
    (let loop ((a (digits g)) (b (digits c)) (acc 0))
      (if (null? a) acc (loop (cdr a) (cdr b) (if (= (car a) (car b)) (+ acc 1) acc)))))
  (define (common-of g c)
    (let loop ((a (digits g)) (acc 0))
      (if (null? a) acc (loop (cdr a) (if (member-digit? (car a) (digits c)) (+ acc 1) acc)))))
  (define (score-matches? g b k c)
    (and (= (bulls-of g c) b) (= (- (common-of g c) (bulls-of g c)) k)))
  (define (all-candidates)
    (let loop ((n 9999) (acc '()))
      (cond ((< n 1000) acc)
            ((distinct-digits? (digits n)) (loop (- n 1) (cons n acc)))
            (else (loop (- n 1) acc)))))
  (define (keep cands g b k)
    (cond ((null? cands) '())
          ((score-matches? g b k (car cands)) (cons (car cands) (keep (cdr cands) g b k)))
          (else (keep (cdr cands) g b k))))
  (define (char-digit s i)
    (let ((x (string->number (substring s i (+ i 1))))) (if (number? x) x #f)))
  (define (reply-digits s)
    (let loop ((i 0) (acc '()))
      (if (= i (string-length s))
          (reverse acc)
          (let ((d (char-digit s i)))
            (loop (+ i 1) (if d (cons d acc) acc))))))
  (define (valid-feedback? ds)
    (and (= (length ds) 2) (<= (car ds) 4) (<= (cadr ds) 4) (<= (+ (car ds) (cadr ds)) 4)))
  (define (ask-feedback guess note)
    (match-result (ask (object (cons "title" "Bulls and Cows")
                               (cons "message" (string-append note "My guess is " (number->string guess) ". How many bulls and cows? Reply with two numbers, e.g. \"1 2\"."))
                               (cons "placeholder" "bulls cows")))
      "action"
      ("accept" r (field (field r "content") "reply"))
      (else other #f)))
  (define (hist->array h)
    (if (null? h)
        (array)
        (array-append (hist->array (cdr h))
                      (object (cons "guess" (number->string (car (car h))))
                              (cons "bulls" (cadr (car h)))
                              (cons "cows" (caddr (car h)))))))
  (define (finish status history count)
    (object (cons "status" status) (cons "guesses" count) (cons "history" (hist->array history))))
  (define (play cands history count note)
    (if (null? cands)
        (finish "inconsistent" history count)
        (let* ((guess (car cands)) (reply (ask-feedback guess note)))
          (if (not reply)
              (finish "stopped" history count)
              (let ((ds (reply-digits reply)))
                (cond ((not (valid-feedback? ds))
                       (play cands history count "I need two numbers: bulls, then cows. "))
                      ((= (car ds) 4)
                       (finish "solved" (cons (list guess 4 0) history) (+ count 1)))
                      (else
                       (let ((b (car ds)) (k (cadr ds)))
                         (play (keep cands guess b k)
                               (cons (list guess b k) history)
                               (+ count 1)
                               "")))))))))
  (play (all-candidates) '() 0 ""))
