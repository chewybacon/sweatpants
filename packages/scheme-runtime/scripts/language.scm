;; Read the evaluator as data. Never load or execute it to discover its API.
(use-modules (ice-9 match) (srfi srfi-1))

(define (find-form predicate tree)
  (cond ((predicate tree) tree)
        ((pair? tree) (or (find-form predicate (car tree))
                          (find-form predicate (cdr tree))))
        (else #f)))
(define (headed? name)
  (lambda (value) (and (pair? value) (eq? (car value) name))))
(define (datum-string value)
  (call-with-output-string (lambda (port) (write value port))))

(define (write-language output)
  (let* ((forms (call-with-input-file "scripts/kernel.scm"
                  (lambda (port)
                    (let loop ((forms '()))
                      (let ((value (read port)))
                        (if (eof-object? value) (reverse forms)
                            (loop (cons value forms))))))))
         (compiler (find-form (lambda (value)
                               (and (pair? value) (eq? (car value) 'define)
                                    (equal? (cadr value) '(compile-source source)))) forms))
         (wrapper (find-form (lambda (value)
                              (and (pair? value) (eq? (car value) 'lambda)
                                   (pair? (cadr value)) (eq? (caadr value) 'effect))) compiler))
         (environment (find-form (headed? 'environment) compiler))
         (helpers (cadr (find-form (headed? 'letrec) wrapper)))
         (macros (cadr (find-form (headed? 'letrec-syntax) wrapper))))
    (unless (and compiler wrapper environment helpers macros)
      (error "Cannot discover the authored language; update language extraction"))
    ;; The emitted data uses only strings, arrays and objects. Scheme's string
    ;; writer is JSON-compatible for these controlled identifiers/signatures.
    (call-with-output-file (string-append output "/language.json")
      (lambda (port)
        (define (strings values)
          (display "[" port)
          (let loop ((values values) (first? #t))
            (unless (null? values)
              (unless first? (display "," port))
              (write (car values) port)
              (loop (cdr values) #f)))
          (display "]" port))
        (display "{\"imports\":" port)
        (strings (append-map
                   (lambda (quoted)
                     (match quoted
                       (('quote ('only module names ...)) (map symbol->string names))
                       (_ (error "Expected explicit language imports" quoted))))
                   (cdr environment)))
        (display ",\"procedures\":[" port)
        (let ((signatures
                (append
                  (filter-map
                    (lambda (name)
                      (if (eq? name 'input) #f
                          (let ((definition (find-form
                                  (lambda (value)
                                    (and (pair? value) (eq? (car value) 'define)
                                         (pair? (cadr value)) (eq? (caadr value) name))) forms)))
                            (unless definition (error "Missing injected procedure" name))
                            (cadr definition))))
                    (cadr wrapper))
                  (map (lambda (binding)
                         (match binding
                           ((name ('lambda args body ...)) (cons name args))
                           (_ (error "Expected helper lambda" binding)))) helpers))))
          (let loop ((signatures signatures) (first? #t))
            (unless (null? signatures)
              (unless first? (display "," port))
              (let ((signature (car signatures)))
                (display "{\"name\":" port) (write (symbol->string (car signature)) port)
                (display ",\"signature\":" port) (write (datum-string signature) port)
                (display "}" port))
              (loop (cdr signatures) #f))))
        (display "],\"macros\":[" port)
        (let loop ((bindings macros) (first? #t))
          (unless (null? bindings)
            (unless first? (display "," port))
            (let ((binding (car bindings)))
              (display "{\"name\":" port) (write (symbol->string (car binding)) port)
              (display ",\"patterns\":" port)
              (strings (map (lambda (rule) (datum-string (car rule))) (cddr (cadr binding))))
              (display "}" port))
            (loop (cdr bindings) #f)))
        (display "],\"values\":[\"input\"]}\n" port)))))
