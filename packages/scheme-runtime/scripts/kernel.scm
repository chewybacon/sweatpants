(use-modules (hoot eval) (hoot environments) (hoot control))

;; JSON containers are distinct from Scheme lists and procedures.
(define (object . entries)
  (list->vector (cons "object" (apply append
    (map (lambda (entry) (list (car entry) (cdr entry))) entries)))))
(define (array . items) (list->vector (cons "array" items)))
(define (json-null) (vector "null"))
(define (tagged? value tag)
  (and (vector? value) (> (vector-length value) 0)
       (equal? (vector-ref value 0) tag)))
(define (field value key)
  (unless (tagged? value "object") (error "field requires an object"))
  (let loop ((i 1))
    (cond ((>= i (vector-length value)) (error "missing field" key))
          ((equal? (vector-ref value i) key) (vector-ref value (+ i 1)))
          (else (loop (+ i 2))))))
(define (array-length value)
  (unless (tagged? value "array") (error "array-length requires a JSON array"))
  (- (vector-length value) 1))
(define (array-ref value index)
  (unless (and (exact-integer? index) (>= index 0) (< index (array-length value)))
    (error "array index out of bounds" index))
  (vector-ref value (+ index 1)))
(define (array-append value item)
  (array-length value)
  (list->vector (append (vector->list value) (list item))))
(define (object-set value key replacement)
  (unless (and (tagged? value "object") (string? key)) (error "object-set requires object and string key"))
  (let loop ((i 1) (entries '()) (found #f))
    (if (>= i (vector-length value))
        (apply object (reverse (if found entries (cons (cons key replacement) entries))))
        (let ((k (vector-ref value i)) (v (vector-ref value (+ i 1))))
          (loop (+ i 2) (cons (cons k (if (equal? k key) replacement v)) entries)
                (or found (equal? k key)))))))
(define (read-one source)
  (call-with-input-string source
    (lambda (port)
      (let ((value (read port)))
        (when (eof-object? value) (error "empty source"))
        (unless (eof-object? (read port)) (error "expected exactly one expression"))
        value))))
(define (printed value) (call-with-output-string (lambda (port) (write value port))))

;; Effects are the only escape from the evaluator. The host selects capability names.
(define tag (make-prompt-tag 'effect))
(define errors (make-prompt-tag 'diagnostic))
(define pending #f)
(define started? #f)
(define allowed '())
(define (protect thunk)
  (call-with-prompt errors
    (lambda ()
      (with-exception-handler
        (lambda (exception) (abort-to-prompt errors (printed exception))) thunk))
    (lambda (continuation message) (values "error" message))))
(define (effect name payload)
  (unless (and (string? name) (member name allowed)) (error "effect capability denied" name))
  (abort-to-prompt tag name payload))
(define (drive thunk)
  (call-with-prompt tag thunk
    (lambda (continuation name payload)
      (set! pending continuation)
      (values "effect" name payload))))

;; Compile without applying: validation expands macros but performs no effects.
(define (compile-source source)
  (unless (and (string? source) (<= (string-length source) 12000)) (error "source exceeds 12000 characters"))
  (eval `(lambda (effect object array json-null field array-ref array-length array-append object-set printed input)
           (letrec ((ask (lambda (request) (effect "ask" request)))
                    (random (lambda (request) (effect "random" request)))
                    (sample (lambda (request) (effect "sample" request)))
                    (decision (lambda (request) (effect "decision" request)))
                    (with-reply (lambda (request accepted stopped)
                      (let ((reply (ask request)))
                        (if (equal? (field reply "action") "accept")
                            (accepted (field reply "content") (field reply "exchange"))
                            (stopped reply)))))
                    (invoke (lambda (code args)
                      (effect "scheme.invoke" (object (cons "program" (printed code)) (cons "input" args))))))
             ,(read-one source)))
        (environment '(only (scheme base)
          lambda let let* letrec if begin quote quasiquote unquote unquote-splicing define
          let-syntax letrec-syntax syntax-rules cond case else => and or when unless
          + - * / = < > <= >= not equal? cons car cdr list null? pair? length reverse append
          map for-each apply string-append number->string string->number string=? string-length
          substring string? number? boolean? symbol? integer? exact-integer? remainder modulo abs
          max min zero? positive? negative?))))
(define (validate source)
  (protect (lambda () (compile-source source) (values "valid"))))
(define (start source capabilities encoded-input)
  (protect (lambda ()
    (when started? (error "program already started"))
    (set! started? #t)
    (set! allowed (cdr (vector->list (read-one capabilities))))
    (let ((program (compile-source source)) (input (read-one encoded-input)))
      (drive (lambda ()
        (values "done" (program effect object array json-null field array-ref array-length
                                array-append object-set printed input))))))))
(define (next encoded)
  (protect (lambda ()
    (unless pending (error "no pending effect"))
    (let ((continuation pending) (value (read-one encoded)))
      (set! pending #f)
      (drive (lambda () (continuation value)))))))
(values validate start next)
