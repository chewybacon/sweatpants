{
  "name": "@sweatpants/chat-contract",
  "version": "0.1.0",
  "description": "Cycle-free canonical first-party chat contracts and decoders",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": {
        "import": "./src/index.ts",
        "types": "./src/index.ts"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./src/index.ts"
    },
    "./content": {
      "development": {
        "import": "./src/content.ts",
        "types": "./src/content.ts"
      },
      "import": {
        "types": "./dist/content.d.ts",
        "default": "./dist/content.js"
      },
      "default": "./src/content.ts"
    }
  },
  "scripts": {
    "build": "tsup && tsc -b --force",
    "check": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "lint": "cd ../.. && oxlint --type-aware packages/chat-contract",
    "lint:fix": "cd ../.. && oxlint --type-aware packages/chat-contract --fix",
    "format": "cd ../.. && oxfmt packages/chat-contract",
    "format:check": "cd ../.. && oxfmt packages/chat-contract --check",
    "build:clean": "tsx ../../scripts/clean-build.ts ."
  },
  "dependencies": {
    "@sweatpants/foundation": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@sweatpants/ts-config": "workspace:*",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
