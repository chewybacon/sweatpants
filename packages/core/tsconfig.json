{
    "extends": "@sweatpants/ts-config/tsconfig.package.json",
    "compilerOptions": {
        "composite": true,
        "emitDeclarationOnly": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "customConditions": ["development"]
    },
    "include": ["src/**/*.ts"],
    "exclude": [
        "dist",
        "node_modules",
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.spec.ts",
        "acceptance"
    ]
}
