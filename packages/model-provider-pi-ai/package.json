{
    "name": "@sweatpants/model-provider-pi-ai",
    "version": "0.1.0",
    "description": "pi-ai model provider adapter for Sweatpants chat",
    "license": "MIT",
    "files": [
        "dist",
        "src"
    ],
    "type": "module",
    "exports": {
        ".": {
            "development": {
                "import": "./src/index.ts",
                "types": "./src/index.ts"
            },
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "scripts": {
        "build": "tsup && pnpm build:types",
        "dev": "tsup --watch",
        "check": "tsc -b",
        "test": "vitest run --passWithNoTests",
        "test:acceptance": "vitest run acceptance",
        "build:types": "tsc -b tsconfig.json --force"
    },
    "dependencies": {
        "@earendil-works/pi-ai": "^0.84.0",
        "@sweatpants/chat-contract": "workspace:*",
        "@sweatpants/foundation": "workspace:*",
        "@sweatpants/model-provider": "workspace:*"
    },
    "devDependencies": {
        "@sweatpants/ts-config": "workspace:*",
        "effection": "catalog:",
        "tsup": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "effection": ">=4.1.0-alpha.9 <5.0.0"
    }
}
