{
  "name": "@sweatpants/model-provider-pi-ai",
  "version": "0.1.0",
  "description": "pi-ai model provider adapter for Sweatpants chat",
  "type": "module",
  "exports": {
    ".": {
      "development": {
        "import": "./src/index.ts",
        "types": "./src/index.ts"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check": "tsc -b",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "effection": ">=4.1.0-alpha.9 <5.0.0",
    "@sweatpants/framework": "workspace:*"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.79.8"
  },
  "devDependencies": {
    "@sweatpants/ts-config": "workspace:*",
    "effection": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@sweatpants/framework": "workspace:*"
  },
  "license": "MIT"
}
