{
  "name": "@sweatpants/model-provider-pi-ai",
  "version": "0.1.0",
  "description": "pi-ai model provider adapter for Sweatpants chat",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": {
        "import": "./src/index.ts",
        "types": "./src/index.ts"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup && pnpm build:types",
    "dev": "tsup --watch",
    "check": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "test:acceptance": "vitest run acceptance",
    "build:types": "tsc -b tsconfig.json --force",
    "lint": "cd ../.. && oxlint --type-aware packages/model-provider-pi-ai",
    "lint:fix": "cd ../.. && oxlint --type-aware packages/model-provider-pi-ai --fix",
    "format": "cd ../.. && oxfmt packages/model-provider-pi-ai",
    "format:check": "cd ../.. && oxfmt packages/model-provider-pi-ai --check",
    "build:clean": "tsx ../../scripts/clean-build.ts .",
    "dev:auth": "tsx ../../scripts/model-auth.ts status",
    "dev:auth:login": "tsx ../../scripts/model-auth.ts login",
    "dev:auth:refresh": "tsx ../../scripts/model-auth.ts refresh",
    "dev:auth:logout": "tsx ../../scripts/model-auth.ts logout",
    "dev:auth:use": "tsx ../../scripts/model-auth.ts use",
    "dev:auth:selection": "tsx ../../scripts/model-auth.ts selection",
    "dev:auth:providers": "tsx ../../scripts/model-auth.ts providers"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.0.1",
    "@sweatpants/chat-contract": "workspace:*",
    "@sweatpants/foundation": "workspace:*",
    "@sweatpants/model-decision": "workspace:*",
    "@sweatpants/model-provider": "workspace:*"
  },
  "devDependencies": {
    "@sweatpants/ts-config": "workspace:*",
    "effection": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effection": ">=4.2.0 <5.0.0"
  }
}
