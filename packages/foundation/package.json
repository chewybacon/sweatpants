{
    "name": "@sweatpants/foundation",
    "version": "0.1.0",
    "description": "Portable JSON, canonicalization, and schema-neutral primitives",
    "license": "MIT",
    "files": [
        "dist",
        "src"
    ],
    "type": "module",
    "exports": {
        ".": {
            "development": {
                "import": "./src/index.ts",
                "types": "./src/index.ts"
            },
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "default": "./src/index.ts"
        },
        "./json": {
            "development": {
                "import": "./src/json.ts",
                "types": "./src/json.ts"
            },
            "import": {
                "types": "./dist/json.d.ts",
                "default": "./dist/json.js"
            },
            "default": "./src/json.ts"
        }
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "check": "tsc -b",
        "test": "vitest run"
    },
    "dependencies": {
        "@noble/hashes": "^2.2.0"
    },
    "devDependencies": {
        "@sweatpants/ts-config": "workspace:*",
        "tsup": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
