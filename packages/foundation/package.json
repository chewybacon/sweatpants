{
    "name": "@sweatpants/foundation",
    "version": "0.1.0",
    "description": "Portable JSON, canonicalization, and schema-neutral primitives",
    "license": "MIT",
    "files": [
        "dist",
        "src"
    ],
    "type": "module",
    "exports": {
        ".": {
            "development": {
                "import": "./src/index.ts",
                "types": "./src/index.ts"
            },
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "default": "./src/index.ts"
        },
        "./json": {
            "development": {
                "import": "./src/json.ts",
                "types": "./src/json.ts"
            },
            "import": {
                "types": "./dist/json.d.ts",
                "default": "./dist/json.js"
            },
            "default": "./src/json.ts"
        },
        "./port": {
            "development": {
                "import": "./src/port.ts",
                "types": "./src/port.ts"
            },
            "import": {
                "types": "./dist/port.d.ts",
                "default": "./dist/port.js"
            },
            "default": "./src/port.ts"
        },
        "./stream": {
            "development": {
                "import": "./src/stream.ts",
                "types": "./src/stream.ts"
            },
            "import": {
                "types": "./dist/stream.d.ts",
                "default": "./dist/stream.js"
            },
            "default": "./src/stream.ts"
        },
        "./errors": {
            "development": {
                "import": "./src/errors.ts",
                "types": "./src/errors.ts"
            },
            "import": {
                "types": "./dist/errors.d.ts",
                "default": "./dist/errors.js"
            },
            "default": "./src/errors.ts"
        },
        "./schema": {
            "development": {
                "import": "./src/schema.ts",
                "types": "./src/schema.ts"
            },
            "import": {
                "types": "./dist/schema.d.ts",
                "default": "./dist/schema.js"
            },
            "default": "./src/schema.ts"
        },
        "./schema-validation": {
            "development": {
                "import": "./src/schema-validation.ts",
                "types": "./src/schema-validation.ts"
            },
            "import": {
                "types": "./dist/schema-validation.d.ts",
                "default": "./dist/schema-validation.js"
            },
            "default": "./src/schema-validation.ts"
        }
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "check": "tsc -b",
        "test": "vitest run"
    },
    "dependencies": {
        "@noble/hashes": "^2.2.0",
        "@standard-schema/spec": "catalog:",
        "effection": "catalog:"
    },
    "devDependencies": {
        "@sweatpants/ts-config": "workspace:*",
        "tsup": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
