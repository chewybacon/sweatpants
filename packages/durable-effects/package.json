{
    "name": "@sweatpants/durable-effects",
    "version": "0.1.0",
    "description": "Durable effect contracts, authoring, and runtime routing",
    "license": "MIT",
    "files": [
        "dist",
        "src"
    ],
    "type": "module",
    "exports": {
        ".": {
            "development": {
                "import": "./src/index.ts",
                "types": "./src/index.ts"
            },
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "default": "./src/index.ts"
        },
        "./contract": {
            "development": {
                "import": "./src/contract.ts",
                "types": "./src/contract.ts"
            },
            "import": {
                "types": "./dist/contract.d.ts",
                "default": "./dist/contract.js"
            },
            "default": "./src/contract.ts"
        },
        "./authoring": {
            "development": {
                "import": "./src/authoring.ts",
                "types": "./src/authoring.ts"
            },
            "import": {
                "types": "./dist/authoring.d.ts",
                "default": "./dist/authoring.js"
            },
            "default": "./src/authoring.ts"
        },
        "./runtime": {
            "development": {
                "import": "./src/runtime.ts",
                "types": "./src/runtime.ts"
            },
            "import": {
                "types": "./dist/runtime.d.ts",
                "default": "./dist/runtime.js"
            },
            "default": "./src/runtime.ts"
        },
        "./model-sample": {
            "development": {
                "import": "./src/model-sample-contract.ts",
                "types": "./src/model-sample-contract.ts"
            },
            "import": {
                "types": "./dist/model-sample-contract.d.ts",
                "default": "./dist/model-sample-contract.js"
            },
            "default": "./src/model-sample-contract.ts"
        }
    },
    "scripts": {
        "build": "tsup",
        "check": "tsc -b",
        "test": "vitest run"
    },
    "dependencies": {
        "@standard-schema/spec": "catalog:",
        "@sweatpants/foundation": "workspace:*",
        "effection": "catalog:"
    },
    "devDependencies": {
        "@sweatpants/ts-config": "workspace:*",
        "tsup": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
