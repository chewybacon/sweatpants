{
  "name": "@sweatpants/durable-streams-cloudflare",
  "version": "0.1.0",
  "description": "Durable Object response buffers and session registry storage",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": {
        "import": "./src/index.ts",
        "types": "./src/index.ts"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./worker": {
      "development": {
        "import": "./src/worker.ts",
        "types": "./src/worker.ts"
      },
      "import": {
        "types": "./dist/worker.d.ts",
        "default": "./dist/worker.js"
      }
    }
  },
  "scripts": {
    "build": "tsup && tsc -b --force",
    "check": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "lint": "cd ../.. && oxlint --type-aware packages/durable-streams-cloudflare",
    "lint:fix": "cd ../.. && oxlint --type-aware packages/durable-streams-cloudflare --fix",
    "format": "cd ../.. && oxfmt packages/durable-streams-cloudflare",
    "format:check": "cd ../.. && oxfmt packages/durable-streams-cloudflare --check",
    "build:clean": "tsx ../../scripts/clean-build.ts ."
  },
  "dependencies": {
    "@cloudflare/workers-types": "5.20261005.1",
    "@sweatpants/durable-streams": "workspace:*",
    "effection": "catalog:"
  },
  "devDependencies": {
    "@sweatpants/ts-config": "workspace:*",
    "@types/node": "catalog:",
    "esbuild": "0.27.2",
    "miniflare": "5.20261001.0-alpha",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
