{
  "name": "@sweatpants/flowmode-backend",
  "version": "0.1.0",
  "description": "WorkflowKernel execution backend for the shared program attachment runtime",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": {
        "import": "./src/index.ts",
        "types": "./src/index.ts"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "check": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "lint": "cd ../.. && oxlint --type-aware packages/flowmode-backend",
    "lint:fix": "cd ../.. && oxlint --type-aware packages/flowmode-backend --fix",
    "format": "cd ../.. && oxfmt packages/flowmode-backend",
    "format:check": "cd ../.. && oxfmt packages/flowmode-backend --check",
    "build:clean": "tsx ../../scripts/clean-build.ts ."
  },
  "dependencies": {
    "@sweatpants/durable-execution": "workspace:*",
    "@sweatpants/flowmode-runtime": "workspace:*",
    "@sweatpants/foundation": "workspace:*",
    "@sweatpants/journal-authority": "workspace:*",
    "@sweatpants/primitive-journal": "workspace:*",
    "effection": "catalog:"
  },
  "devDependencies": {
    "@sweatpants/ts-config": "workspace:*",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
