{
  "name": "@sweatpants/standard-durability-effect",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": {
        "import": "./src/index.ts",
        "types": "./src/index.ts"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "check": "tsc -b",
    "lint": "cd ../.. && oxlint --type-aware packages/standard-durability-effect",
    "format:check": "cd ../.. && oxfmt packages/standard-durability-effect --check"
  },
  "dependencies": {
    "@sweatpants/standard-durability": "workspace:*"
  },
  "devDependencies": {
    "@sweatpants/ts-config": "workspace:*",
    "effect": "^4.0.6",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.0.6"
  }
}
