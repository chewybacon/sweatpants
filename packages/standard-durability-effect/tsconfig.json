{
  "extends": "@sweatpants/ts-config/tsconfig.package.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "./.cache/types",
    "rootDir": "./src",
    "customConditions": ["development"],
    "noUncheckedIndexedAccess": false,
    "tsBuildInfoFile": "./.cache/tsconfig.check.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules", "**/*.test.ts"],
  "references": [
    {
      "path": "../standard-durability"
    },
    {
      "path": "../runtime-effect"
    }
  ]
}
