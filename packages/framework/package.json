{
    "name": "@sweatpants/framework",
    "version": "0.1.0",
    "description": "Framework utilities for TanStack-based AI apps - tool discovery, codegen, and more",
    "keywords": [
        "codegen",
        "framework",
        "tanstack",
        "tools",
        "vite"
    ],
    "license": "MIT",
    "files": [
        "dist",
        "src"
    ],
    "type": "module",
    "exports": {
        ".": {
            "development": {
                "import": "./src/lib/chat/index.ts",
                "types": "./src/lib/chat/index.ts"
            },
            "import": {
                "types": "./dist/lib/chat/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/lib/chat/index.d.ts",
                "default": "./dist/index.cjs"
            }
        },
        "./server": {
            "development": {
                "import": "./src/server/index.ts",
                "types": "./src/server/index.ts"
            },
            "import": {
                "types": "./dist/server/index.d.ts",
                "default": "./dist/server.js"
            },
            "require": {
                "types": "./dist/server/index.d.ts",
                "default": "./dist/server.cjs"
            }
        },
        "./server/testing": {
            "development": {
                "import": "./src/server/testing.ts",
                "types": "./src/server/testing.ts"
            },
            "import": {
                "types": "./dist/server/testing.d.ts",
                "default": "./dist/server/testing.js"
            },
            "require": {
                "types": "./dist/server/testing.d.ts",
                "default": "./dist/server/testing.cjs"
            }
        },
        "./chat": {
            "development": {
                "import": "./src/lib/chat/index.ts",
                "types": "./src/lib/chat/index.ts"
            },
            "import": {
                "types": "./dist/lib/chat/index.d.ts",
                "default": "./dist/chat.js"
            },
            "require": {
                "types": "./dist/lib/chat/index.d.ts",
                "default": "./dist/chat.cjs"
            }
        },
        "./chat/browser-rendering": {
            "development": {
                "import": "./src/lib/chat/browser-rendering/index.ts",
                "types": "./src/lib/chat/browser-rendering/index.ts"
            },
            "import": {
                "types": "./dist/lib/chat/browser-rendering/index.d.ts",
                "default": "./dist/chat/browser-rendering.js"
            },
            "require": {
                "types": "./dist/lib/chat/browser-rendering/index.d.ts",
                "default": "./dist/chat/browser-rendering.cjs"
            }
        },
        "./chat/mcp-tools": {
            "development": {
                "import": "./src/lib/chat/mcp-tools/index.ts",
                "types": "./src/lib/chat/mcp-tools/index.ts"
            },
            "import": {
                "types": "./dist/lib/chat/mcp-tools/index.d.ts",
                "default": "./dist/chat/mcp-tools.js"
            },
            "require": {
                "types": "./dist/lib/chat/mcp-tools/index.d.ts",
                "default": "./dist/chat/mcp-tools.cjs"
            }
        },
        "./deployment": {
            "development": {
                "import": "./src/deployment/index.ts",
                "types": "./src/deployment/index.ts"
            },
            "import": {
                "types": "./dist/deployment/index.d.ts",
                "default": "./dist/deployment.js"
            },
            "require": {
                "types": "./dist/deployment/index.d.ts",
                "default": "./dist/deployment.cjs"
            }
        }
    },
    "scripts": {
        "build": "tsup && pnpm build:types",
        "dev": "tsup --watch",
        "check": "tsc -b",
        "test": "vitest",
        "test:acceptance": "vitest run acceptance",
        "build:types": "tsc -b tsconfig.lib.json --force"
    },
    "dependencies": {
        "@standard-schema/spec": "catalog:",
        "@sweatpants/a2a": "workspace:*",
        "@sweatpants/agent-sdk": "workspace:*",
        "@sweatpants/chat-core": "workspace:*",
        "@sweatpants/durable-chat-runtime": "workspace:*",
        "@sweatpants/durable-effects": "workspace:*",
        "@sweatpants/durable-execution": "workspace:*",
        "@sweatpants/durable-streams": "workspace:*",
        "@sweatpants/elicit-context": "workspace:*",
        "@sweatpants/foundation": "workspace:*",
        "@sweatpants/journal-authority": "workspace:*",
        "@sweatpants/session-contract": "workspace:*",
        "@sweatpants/stream-bridge": "workspace:*",
        "@sweatpants/tool-session": "workspace:*",
        "pg": "^8.13.1",
        "pino": "^9.6.0",
        "pino-pretty": "^13.0.0",
        "redis": "^4.7.0"
    },
    "devDependencies": {
        "@babel/core": "^7.24.0",
        "@babel/preset-typescript": "^7.24.0",
        "@babel/types": "^7.24.0",
        "@effectionx/context-api": "catalog:",
        "@effectionx/raf": "catalog:",
        "@interactors/html": "^1.0.1",
        "@sweatpants/ts-config": "workspace:*",
        "@testing-library/react": "catalog:",
        "@types/babel__core": "^7.20.5",
        "@types/node": "catalog:",
        "@types/pg": "^8.11.10",
        "@types/react": "catalog:",
        "clsx": "^2.1.1",
        "effection": "catalog:",
        "fast-glob": "^3.3.2",
        "katex": "^0.16.27",
        "magic-string": "catalog:",
        "marked": "^17.0.1",
        "mermaid": "^11.12.2",
        "react": "catalog:",
        "shiki": "^3.20.0",
        "tailwind-merge": "catalog:",
        "tsup": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:",
        "zod": "catalog:"
    },
    "peerDependencies": {
        "@effectionx/context-api": "^0.2.1",
        "effection": ">=4.1.0-alpha.9 <5.0.0",
        "zod": "^3.24.0 || ^4.0.0"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=22.19.0"
    }
}
