{
  "name": "@sweatpants/model-provider",
  "version": "0.1.0",
  "description": "Protocol-neutral model runtime contracts and provider port",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": {
        "import": "./src/index.ts",
        "types": "./src/index.ts"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "check": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "lint": "cd ../.. && oxlint --type-aware packages/model-provider",
    "lint:fix": "cd ../.. && oxlint --type-aware packages/model-provider --fix",
    "format": "cd ../.. && oxfmt packages/model-provider",
    "format:check": "cd ../.. && oxfmt packages/model-provider --check",
    "build:clean": "tsx ../../scripts/clean-build.ts ."
  },
  "dependencies": {
    "@sweatpants/chat-contract": "workspace:*",
    "@sweatpants/foundation": "workspace:*",
    "effection": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@sweatpants/ts-config": "workspace:*",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effection": ">=4.2.0 <5.0.0"
  }
}
