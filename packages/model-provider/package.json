{
    "name": "@sweatpants/model-provider",
    "version": "0.1.0",
    "description": "Protocol-neutral model runtime contracts and provider port",
    "license": "MIT",
    "files": [
        "dist",
        "src"
    ],
    "type": "module",
    "exports": {
        ".": {
            "development": {
                "import": "./src/index.ts",
