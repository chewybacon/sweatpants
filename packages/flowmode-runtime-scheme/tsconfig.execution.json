{
  "extends": "@sweatpants/ts-config/tsconfig.package.json",
  "compilerOptions": {
    "incremental": true,
    "rootDir": "src",
    "outDir": "dist",
    "emitDeclarationOnly": false,
    "rewriteRelativeImportExtensions": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": ["src/execution/**/*.mts"],
  "exclude": ["src/**/__tests__/**"]
}
