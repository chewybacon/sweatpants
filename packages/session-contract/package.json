{
    "name": "@sweatpants/session-contract",
    "version": "0.1.0",
    "description": "ProgramDriver durable runtime, journal authority, schemas, and conformance kit",
    "license": "MIT",
    "files": [
        "dist",
        "src",
        "docs"
    ],
    "type": "module",
    "exports": {
        ".": {
            "development": {
                "import": "./src/index.ts",
                "types": "./src/index.ts"
            },
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        },
        "./testing": {
            "development": {
                "import": "./src/testing/index.ts",
                "types": "./src/testing/index.ts"
            },
            "import": {
                "types": "./dist/testing.d.ts",
                "default": "./dist/testing.js"
            }
        }
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "check": "tsc -b",
        "test": "vitest"
    },
    "dependencies": {
        "@noble/hashes": "^2.2.0",
        "@standard-schema/spec": "catalog:",
        "@sweatpants/durable-effects": "workspace:*",
        "@sweatpants/durable-execution": "workspace:*",
        "@sweatpants/foundation": "workspace:*",
        "@sweatpants/journal-authority": "workspace:*",
        "@sweatpants/tool-session": "workspace:*",
        "effection": "catalog:"
    },
    "devDependencies": {
        "@sweatpants/ts-config": "workspace:*",
        "@types/node": "catalog:",
        "tsup": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
