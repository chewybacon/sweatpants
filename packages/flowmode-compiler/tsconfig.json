{
  "extends": "@sweatpants/ts-config/tsconfig.package.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "allowImportingTsExtensions": false,
    "allowJs": false,
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/__tests__/**"],
  "references": [
    {
      "path": "../flowmode-runtime"
    },
    {
      "path": "../durable-execution"
    },
    {
      "path": "../foundation"
    }
  ]
}
