{
  "name": "@sweatpants/storage-d1",
  "version": "0.1.0",
  "description": "D1 durable journal and conversation storage",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": {
        "import": "./src/index.ts",
        "types": "./src/index.ts"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup && tsc -b --force",
    "check": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "db:generate": "node scripts/generate-schema.mjs && oxfmt src/schema-sql.ts",
    "lint": "cd ../.. && oxlint --type-aware packages/storage-d1",
    "lint:fix": "cd ../.. && oxlint --type-aware packages/storage-d1 --fix",
    "format": "cd ../.. && oxfmt packages/storage-d1",
    "format:check": "cd ../.. && oxfmt packages/storage-d1 --check",
    "build:clean": "tsx ../../scripts/clean-build.ts ."
  },
  "dependencies": {
    "@cloudflare/workers-types": "5.20261005.1",
    "@sweatpants/durable-storage-kernel": "workspace:*",
    "@sweatpants/foundation": "workspace:*",
    "@sweatpants/history-store": "workspace:*",
    "@sweatpants/journal-authority": "workspace:*",
    "@sweatpants/storage-sqlite": "workspace:*",
    "drizzle-orm": "catalog:",
    "effection": "catalog:"
  },
  "devDependencies": {
    "@sweatpants/ts-config": "workspace:*",
    "@types/node": "catalog:",
    "esbuild": "0.27.2",
    "miniflare": "5.20261001.0-alpha",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
