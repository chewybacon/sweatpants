{
  "name": "@sweatpants/tool-runtime-agentcore",
  "version": "0.1.0",
  "description": "AgentCore tool runtime adapter for Sweatpants chat",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": {
        "import": "./src/index.ts",
        "types": "./src/index.ts"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./host": {
      "development": {
        "import": "./src/host.ts",
        "types": "./src/host.ts"
      },
      "import": {
        "types": "./dist/host.d.ts",
        "default": "./dist/host.js"
      },
      "require": {
        "types": "./dist/host.d.ts",
        "default": "./dist/host.cjs"
      }
    },
    "./evaluator-runtime": {
      "development": {
        "import": "./src/evaluator-runtime.ts",
        "types": "./src/evaluator-runtime.ts"
      },
      "import": {
        "types": "./dist/evaluator-runtime.d.ts",
        "default": "./dist/evaluator-runtime.js"
      },
      "require": {
        "types": "./dist/evaluator-runtime.d.ts",
        "default": "./dist/evaluator-runtime.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup && pnpm build:types",
    "dev": "tsup --watch",
    "check": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run src",
    "test:e2e:agentcore": "vitest run --config vitest.agentcore-e2e.config.ts",
    "build:types": "tsc -b tsconfig.json --force",
    "lint": "cd ../.. && oxlint --type-aware packages/tool-runtime-agentcore",
    "lint:fix": "cd ../.. && oxlint --type-aware packages/tool-runtime-agentcore --fix",
    "format": "cd ../.. && oxfmt packages/tool-runtime-agentcore",
    "format:check": "cd ../.. && oxfmt packages/tool-runtime-agentcore --check",
    "build:clean": "tsx ../../scripts/clean-build.ts ."
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.996.0",
    "@aws-sdk/credential-provider-node": "^3.972.57",
    "@smithy/protocol-http": "^5.5.1",
    "@smithy/signature-v4": "^5.5.1",
    "@sweatpants/chat-contract": "workspace:*",
    "@sweatpants/chat-core": "workspace:*",
    "@sweatpants/durable-effects": "workspace:*",
    "@sweatpants/durable-execution": "workspace:*",
    "@sweatpants/durable-streams": "workspace:*",
    "@sweatpants/foundation": "workspace:*",
    "@sweatpants/journal-authority": "workspace:*",
    "@sweatpants/model-provider": "workspace:*",
    "@sweatpants/model-sampling": "workspace:*",
    "@sweatpants/tool-runtime": "workspace:*",
    "@sweatpants/tool-session": "workspace:*",
    "redis": "^4.7.0",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@sweatpants/agent-sdk": "workspace:*",
    "@sweatpants/ts-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "effection": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effection": ">=4.2.0 <5.0.0"
  }
}
