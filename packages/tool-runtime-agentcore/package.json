{
    "name": "@sweatpants/tool-runtime-agentcore",
    "version": "0.1.0",
    "description": "AgentCore tool runtime adapter for Sweatpants chat",
    "license": "MIT",
    "files": [
        "dist",
        "src"
    ],
    "type": "module",
    "exports": {
        ".": {
            "development": {
                "import": "./src/index.ts",
                "types": "./src/index.ts"
            },
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.cjs"
            }
        },
        "./host": {
            "development": {
                "import": "./src/host.ts",
                "types": "./src/host.ts"
            },
            "import": {
                "types": "./dist/host.d.ts",
                "default": "./dist/host.js"
            },
            "require": {
                "types": "./dist/host.d.ts",
                "default": "./dist/host.cjs"
            }
        },
        "./evaluator-runtime": {
            "development": {
                "import": "./src/evaluator-runtime.ts",
                "types": "./src/evaluator-runtime.ts"
            },
            "import": {
                "types": "./dist/evaluator-runtime.d.ts",
                "default": "./dist/evaluator-runtime.js"
            },
            "require": {
                "types": "./dist/evaluator-runtime.d.ts",
                "default": "./dist/evaluator-runtime.cjs"
            }
        }
    },
    "scripts": {
        "build": "pnpm build:deps && tsup && pnpm build:types",
        "build:deps": "pnpm --filter @sweatpants/framework build:types",
        "dev": "tsup --watch",
        "check": "pnpm build:deps && tsc -b",
        "test": "vitest run src acceptance",
        "test:acceptance": "vitest run acceptance",
        "test:e2e:agentcore": "vitest run --config vitest.agentcore-e2e.config.ts",
        "build:types": "tsc -b tsconfig.json --force"
    },
    "dependencies": {
        "@aws-sdk/client-bedrock-agentcore": "^3.996.0",
        "@aws-sdk/credential-provider-node": "^3.972.57",
        "@smithy/protocol-http": "^5.5.1",
        "@smithy/signature-v4": "^5.5.1",
        "@sweatpants/durable-effects": "workspace:*",
        "@sweatpants/durable-execution": "workspace:*",
        "@sweatpants/durable-streams": "workspace:*",
        "@sweatpants/foundation": "workspace:*",
        "@sweatpants/session-contract": "workspace:*",
        "@sweatpants/tool-session": "workspace:*",
        "redis": "^4.7.0",
        "ws": "catalog:"
    },
    "devDependencies": {
        "@sweatpants/agent-sdk": "workspace:*",
        "@sweatpants/framework": "workspace:*",
        "@sweatpants/ts-config": "workspace:*",
        "@types/node": "catalog:",
        "@types/ws": "catalog:",
        "effection": "catalog:",
        "tsup": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:",
        "zod": "catalog:"
    },
    "peerDependencies": {
        "@sweatpants/framework": "workspace:*",
        "effection": ">=4.1.0-alpha.9 <5.0.0"
    }
}
