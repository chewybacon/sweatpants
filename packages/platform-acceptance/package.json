{
  "name": "@sweatpants/platform-acceptance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "test": "pnpm test:memory && pnpm test:sqlite && pnpm test:process",
    "test:sqlite": "PLATFORM_ACCEPTANCE_STORAGE=sqlite vitest run --maxWorkers=1 src/__tests__/message-order.acceptance.test.ts",
    "test:memory": "PLATFORM_ACCEPTANCE_STORAGE=memory vitest run --maxWorkers=4 --exclude src/__tests__/process/storage-spine.test.ts --exclude src/__tests__/process/storage-spine-defects.acceptance.test.ts --exclude src/__tests__/message-order.acceptance.test.ts",
    "test:process": "vitest run --maxWorkers=1 src/__tests__/process/storage-spine.test.ts src/__tests__/process/storage-spine-defects.acceptance.test.ts"
  },
  "dependencies": {
    "@ag-ui/core": "1.0.1",
    "@sweatpants/agent-host": "workspace:*",
    "@sweatpants/agent-sdk": "workspace:*",
    "@sweatpants/chat-contract": "workspace:*",
    "@sweatpants/chat-core": "workspace:*",
    "@sweatpants/durable-chat-runtime": "workspace:*",
    "@sweatpants/durable-effects": "workspace:*",
    "@sweatpants/durable-execution": "workspace:*",
    "@sweatpants/foundation": "workspace:*",
    "@sweatpants/history-store": "workspace:*",
    "@sweatpants/journal-authority": "workspace:*",
    "@sweatpants/model-provider": "workspace:*",
    "@sweatpants/model-provider-pi-ai": "workspace:*",
    "@sweatpants/model-sampling": "workspace:*",
    "@sweatpants/storage-sqlite": "workspace:*",
    "@sweatpants/test-rig": "workspace:*",
    "@sweatpants/tool-runtime": "workspace:*",
    "@sweatpants/tool-runtime-agentcore": "workspace:*",
    "@sweatpants/tool-runtime-local": "workspace:*",
    "@sweatpants/tool-session": "workspace:*",
    "drizzle-orm": "catalog:",
    "effection": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@sweatpants/ts-config": "workspace:*",
    "@types/ws": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "ws": "catalog:"
  }
}
