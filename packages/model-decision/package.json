{
  "name": "@sweatpants/model-decision",
  "version": "0.1.0",
  "description": "Typed model decisions, provider port, and durable choice effect",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": {
        "import": "./src/index.ts",
        "types": "./src/index.ts"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "check": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "lint": "cd ../.. && oxlint --type-aware packages/model-decision",
    "lint:fix": "cd ../.. && oxlint --type-aware packages/model-decision --fix",
    "format": "cd ../.. && oxfmt packages/model-decision",
    "format:check": "cd ../.. && oxfmt packages/model-decision --check",
    "build:clean": "tsx ../../scripts/clean-build.ts ."
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:",
    "@sweatpants/durable-effects": "workspace:*",
    "@sweatpants/foundation": "workspace:*",
    "effection": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@sweatpants/ts-config": "workspace:*",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
