{
  "name": "@standard-durability/core",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "import": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internal": {
      "development": {
        "types": "./src/api-internal.ts",
        "import": "./src/api-internal.ts"
      },
      "types": "./dist/api-internal.d.ts",
      "import": "./dist/api-internal.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "cd ../../.. && oxlint --type-aware packages/v2/standard-durability",
    "format:check": "cd ../../.. && oxfmt packages/v2/standard-durability --check"
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
