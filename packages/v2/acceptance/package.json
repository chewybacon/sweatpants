{
  "name": "@sweatpan.ts/acceptance",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "import": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json",
    "lint": "cd ../../.. && oxlint --type-aware packages/v2/acceptance",
    "format:check": "cd ../../.. && oxfmt packages/v2/acceptance --check",
    "test": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --conditions=development\" vitest run",
    "test:watch": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --conditions=development\" vitest"
  },
  "devDependencies": {
    "@sweatpan.ts/testing": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
