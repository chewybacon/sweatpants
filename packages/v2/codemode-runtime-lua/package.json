{
  "name": "@sweatpan.ts/codemode-runtime-lua",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "files": [
    "dist",
    "generated",
    "scripts",
    "vm/src",
    "vm/Cargo.toml",
    "vm/Cargo.lock",
    "vm/prelude.lua",
    "vm/piccolo-checkpoint.patch",
    "vm/.cargo/config.toml"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "import": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm wasm:check && tsc -p tsconfig.json",
    "check": "pnpm wasm:check && tsc -p tsconfig.json --noEmit",
    "lint": "cd ../../.. && oxlint --type-aware packages/v2/codemode-runtime-lua",
    "format:check": "cd ../../.. && oxfmt packages/v2/codemode-runtime-lua --check",
    "wasm:build": "python3 scripts/build.py",
    "wasm:check": "python3 scripts/manifest.py",
    "wasm:verify": "python3 scripts/build.py --verify"
  },
  "dependencies": {
    "@standard-durability/core": "workspace:*",
    "@sweatpan.ts/codemode-runtime": "workspace:*",
    "@sweatpan.ts/core": "workspace:*",
    "@sweatpan.ts/execution": "workspace:*",
    "@sweatpan.ts/runtime": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
