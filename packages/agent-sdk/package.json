{
  "name": "@sweatpants/agent-sdk",
  "version": "0.1.0",
  "description": "Tool authoring, agent contracts, resources, and worker transport for Sweatpants",
  "keywords": [
    "agent",
    "effection",
    "transport"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": {
        "import": "./src/index.ts",
        "types": "./src/index.ts"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./src/index.ts"
    },
    "./tools": {
      "development": {
        "import": "./src/tool/index.ts",
        "types": "./src/tool/index.ts"
      },
      "import": {
        "types": "./dist/tool/index.d.ts",
        "default": "./dist/tool/index.js"
      }
    },
    "./tool": {
      "development": {
        "import": "./src/tool/index.ts",
        "types": "./src/tool/index.ts"
      },
      "import": {
        "types": "./dist/tool/index.d.ts",
        "default": "./dist/tool/index.js"
      }
    },
    "./transport/worker": {
      "development": {
        "import": "./src/transport/worker/index.ts",
        "types": "./src/transport/worker/index.ts"
      },
      "import": {
        "types": "./dist/transport/worker.d.ts",
        "default": "./dist/transport/worker.js"
      }
    },
    "./legacy": {
      "development": {
        "import": "./src/legacy.ts",
        "types": "./src/legacy.ts"
      },
      "import": {
        "types": "./dist/legacy.d.ts",
        "default": "./dist/legacy.js"
      },
      "default": "./src/legacy.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:acceptance": "vitest run acceptance",
    "lint": "cd ../.. && oxlint --type-aware packages/agent-sdk",
    "lint:fix": "cd ../.. && oxlint --type-aware packages/agent-sdk --fix",
    "format": "cd ../.. && oxfmt packages/agent-sdk",
    "format:check": "cd ../.. && oxfmt packages/agent-sdk --check",
    "build:clean": "tsx ../../scripts/clean-build.ts ."
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:",
    "@sweatpants/chat-contract": "workspace:*",
    "@sweatpants/durable-effects": "workspace:*",
    "@sweatpants/durable-execution": "workspace:*",
    "@sweatpants/foundation": "workspace:*",
    "@sweatpants/model-decision": "workspace:*",
    "@sweatpants/model-provider": "workspace:*",
    "@sweatpants/model-sampling": "workspace:*",
    "@sweatpants/standard-durability": "workspace:*",
    "@sweatpants/standard-durability-effection": "workspace:*",
    "base64-js": "1.5.1",
    "effection": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@effectionx/vitest": "catalog:",
    "@effectionx/worker": "catalog:",
    "@sweatpants/ts-config": "workspace:*",
    "@types/node": "catalog:",
    "effection": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@effectionx/worker": "^0.5.2"
  }
}
