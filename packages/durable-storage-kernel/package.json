{
  "name": "@sweatpants/durable-storage-kernel",
  "version": "0.1.0",
  "description": "Bounded durable mutation kernel and memory reference implementation",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": {
        "import": "./src/index.ts",
        "types": "./src/index.ts"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./src/index.ts"
    },
    "./memory": {
      "development": {
        "import": "./src/memory.ts",
        "types": "./src/memory.ts"
      },
      "import": {
        "types": "./dist/memory.d.ts",
        "default": "./dist/memory.js"
      },
      "default": "./src/memory.ts"
    },
    "./testing": {
      "development": {
        "import": "./src/testing.ts",
        "types": "./src/testing.ts"
      },
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "default": "./src/testing.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "check": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "oxlint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@sweatpants/foundation": "workspace:*",
    "effection": "catalog:"
  },
  "devDependencies": {
    "@sweatpants/ts-config": "workspace:*",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
