{
  "name": "@sweatpants/flowmode-runtime",
  "version": "0.1.0",
  "description": "Portable workflow kernel contract and compatibility checks",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": {
        "import": "./src/index.ts",
        "types": "./src/index.ts"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./compiled-tool": {
      "development": {
        "import": "./src/compiled-tool.ts",
        "types": "./src/compiled-tool.ts"
      },
      "import": {
        "types": "./dist/compiled-tool.d.ts",
        "default": "./dist/compiled-tool.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "check": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@sweatpants/durable-execution": "workspace:*",
    "@sweatpants/foundation": "workspace:*",
    "effection": "catalog:"
  },
  "devDependencies": {
    "@sweatpants/ts-config": "workspace:*",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
