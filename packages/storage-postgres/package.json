{
    "name": "@sweatpants/storage-postgres",
    "version": "0.1.0",
    "description": "Postgres conversation and execution durability spine",
    "license": "MIT",
    "files": [
        "dist",
        "src",
        "drizzle"
    ],
    "type": "module",
    "exports": {
        ".": {
            "development": {
                "import": "./src/index.ts",
                "types": "./src/index.ts"
            },
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "default": "./src/index.ts"
        },
        "./schema": {
            "development": {
                "import": "./src/schema.ts",
                "types": "./src/schema.ts"
            },
            "import": {
                "types": "./dist/schema.d.ts",
                "default": "./dist/schema.js"
            },
            "default": "./src/schema.ts"
        },
        "./repository": {
            "development": {
                "import": "./src/repository.ts",
                "types": "./src/repository.ts"
            },
            "import": {
                "types": "./dist/repository.d.ts",
                "default": "./dist/repository.js"
            },
            "default": "./src/repository.ts"
        },
        "./pg-binding": {
            "development": {
                "import": "./src/pg-binding.ts",
                "types": "./src/pg-binding.ts"
            },
            "import": {
                "types": "./dist/pg-binding.d.ts",
                "default": "./dist/pg-binding.js"
            },
            "default": "./src/pg-binding.ts"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsup",
        "check": "tsc -b",
        "typecheck": "tsc -b",
        "lint": "oxlint src",
        "test": "vitest run",
        "db:generate": "drizzle-kit generate"
    },
    "dependencies": {
        "@sweatpants/durable-storage-kernel": "workspace:*",
        "@sweatpants/foundation": "workspace:*",
        "@sweatpants/history-store": "workspace:*",
        "@sweatpants/journal-authority": "workspace:*",
        "drizzle-orm": "catalog:",
        "effection": "catalog:",
        "pg": "catalog:"
    },
    "devDependencies": {
        "@sweatpants/storage-sqlite": "workspace:*",
        "@sweatpants/ts-config": "workspace:*",
        "@types/pg": "catalog:",
        "drizzle-kit": "catalog:",
        "tsup": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
