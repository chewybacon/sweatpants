{
  "name": "@sweatpants/flowmode-compiler-scheme",
  "version": "0.1.0",
  "description": "Scheme target for portable workflow compilation",
  "license": "MIT",
  "files": [
    "src",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "lint": "cd ../.. && oxlint --type-aware packages/flowmode-compiler-scheme",
    "lint:fix": "cd ../.. && oxlint --type-aware packages/flowmode-compiler-scheme --fix",
    "format": "cd ../.. && oxfmt packages/flowmode-compiler-scheme",
    "format:check": "cd ../.. && oxfmt packages/flowmode-compiler-scheme --check",
    "build:clean": "tsx ../../scripts/clean-build.ts ."
  },
  "dependencies": {
    "@sweatpants/flowmode-compiler": "workspace:*",
    "@sweatpants/flowmode-runtime": "workspace:*",
    "effection": "catalog:"
  },
  "devDependencies": {
    "@sweatpants/ts-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
