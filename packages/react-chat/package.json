{
    "name": "@sweatpants/react-chat",
    "version": "0.1.0",
    "description": "React adapter for Sweatpants chat applications",
    "license": "MIT",
    "files": [
        "dist",
        "src"
    ],
    "type": "module",
    "exports": {
        ".": {
            "development": {
                "import": "./src/index.ts",
                "types": "./src/index.ts"
            },
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "scripts": {
        "build": "tsup && pnpm build:types",
        "dev": "tsup --watch",
        "check": "tsc -b",
        "test": "vitest run --passWithNoTests",
        "test:acceptance": "vitest run acceptance --environment jsdom",
        "build:types": "tsc -b tsconfig.json --force"
    },
    "dependencies": {
        "@sweatpants/chat-client": "workspace:*",
        "@sweatpants/foundation": "workspace:*",
        "@sweatpants/frame-renderer": "workspace:*",
        "@sweatpants/tool-session": "workspace:*",
        "effection": "catalog:"
    },
    "devDependencies": {
        "@ag-ui/core": "0.0.57",
        "@effectionx/raf": "catalog:",
        "@sweatpants/agent-host": "workspace:*",
        "@sweatpants/agent-sdk": "workspace:*",
        "@sweatpants/chat-core": "workspace:*",
        "@sweatpants/durable-chat-runtime": "workspace:*",
        "@sweatpants/journal-authority": "workspace:*",
        "@sweatpants/test-rig": "workspace:*",
        "@sweatpants/tool-runtime": "workspace:*",
        "@sweatpants/tool-runtime-local": "workspace:*",
        "@sweatpants/ts-config": "workspace:*",
        "@testing-library/react": "catalog:",
        "@types/react": "catalog:",
        "effection": "catalog:",
        "react": "catalog:",
        "tsup": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:",
        "zod": "catalog:"
    },
    "peerDependencies": {
        "effection": ">=4.2.0 <5.0.0",
        "react": "^19.0.0"
    }
}
