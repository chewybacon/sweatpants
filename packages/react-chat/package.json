{
  "name": "@sweatpants/react-chat",
  "version": "0.1.0",
  "description": "React adapter for Sweatpants chat applications",
  "type": "module",
  "exports": {
    ".": {
      "development": {
        "import": "./src/index.ts",
        "types": "./src/index.ts"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./pipeline": {
      "development": {
        "import": "./src/pipeline/index.ts",
        "types": "./src/pipeline/index.ts"
      },
      "import": {
        "types": "./dist/pipeline.d.ts",
        "default": "./dist/pipeline.js"
      },
      "require": {
        "types": "./dist/pipeline.d.cts",
        "default": "./dist/pipeline.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check": "tsc -b",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "@sweatpants/framework": "workspace:*",
    "@effectionx/raf": "^0.1.1",
    "effection": ">=4.1.0-alpha.9 <5.0.0",
    "react": "^19.0.0",
    "katex": "^0.16.27",
    "marked": "^17.0.1",
    "mermaid": "^11.12.2",
    "shiki": "^3.20.0",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@effectionx/raf": "catalog:",
    "@sweatpants/framework": "workspace:*",
    "@sweatpants/ts-config": "workspace:*",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "effection": "catalog:",
    "katex": "^0.16.27",
    "marked": "^17.0.1",
    "mermaid": "^11.12.2",
    "react": "catalog:",
    "shiki": "^3.20.0",
    "tailwind-merge": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "MIT"
}
