{
    "name": "@sweatpants/react-chat",
    "version": "0.1.0",
    "description": "React adapter for Sweatpants chat applications",
    "license": "MIT",
    "files": [
        "dist",
        "src"
    ],
    "type": "module",
    "exports": {
        ".": {
            "development": {
                "import": "./src/index.ts",
                "types": "./src/index.ts"
            },
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.cjs"
            }
        },
        "./pipeline": {
            "development": {
                "import": "./src/pipeline/index.ts",
                "types": "./src/pipeline/index.ts"
            },
            "import": {
                "types": "./dist/pipeline/index.d.ts",
                "default": "./dist/pipeline.js"
            },
            "require": {
                "types": "./dist/pipeline/index.d.ts",
                "default": "./dist/pipeline.cjs"
            }
        }
    },
    "scripts": {
        "build": "tsup && pnpm build:types",
        "dev": "tsup --watch",
        "check": "tsc -b",
        "test": "vitest run --passWithNoTests",
        "test:acceptance": "vitest run acceptance --environment jsdom",
        "build:types": "tsc -b tsconfig.json --force"
    },
    "devDependencies": {
        "@effectionx/raf": "catalog:",
        "@sweatpants/core": "workspace:*",
        "@sweatpants/framework": "workspace:*",
        "@sweatpants/test-rig": "workspace:*",
        "@sweatpants/tool-runtime-local": "workspace:*",
        "@sweatpants/ts-config": "workspace:*",
        "@testing-library/react": "catalog:",
        "@types/react": "catalog:",
        "effection": "catalog:",
        "katex": "^0.16.27",
        "marked": "^17.0.1",
        "mermaid": "^11.12.2",
        "react": "catalog:",
        "shiki": "^3.20.0",
        "tailwind-merge": "catalog:",
        "tsup": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:",
        "zod": "catalog:"
    },
    "peerDependencies": {
        "@effectionx/raf": "^0.1.1",
        "@sweatpants/framework": "workspace:*",
        "effection": ">=4.1.0-alpha.9 <5.0.0",
        "katex": "^0.16.27",
        "marked": "^17.0.1",
        "mermaid": "^11.12.2",
        "react": "^19.0.0",
        "shiki": "^3.20.0",
        "tailwind-merge": "^2.5.2"
    }
}
