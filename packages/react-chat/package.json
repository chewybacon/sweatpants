{
  "name": "@sweatpants/react-chat",
  "version": "0.1.0",
  "description": "React adapter for Sweatpants chat applications",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": {
        "import": "./src/index.ts",
        "types": "./src/index.ts"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./pipeline": {
      "development": {
        "import": "./src/pipeline/index.ts",
        "types": "./src/pipeline/index.ts"
      },
      "import": {
        "types": "./dist/pipeline/index.d.ts",
        "default": "./dist/pipeline.js"
      },
      "require": {
        "types": "./dist/pipeline/index.d.ts",
        "default": "./dist/pipeline.cjs"
      }
    },
    "./browser-rendering": {
      "development": {
        "import": "./src/browser-rendering/index.ts",
        "types": "./src/browser-rendering/index.ts"
      },
      "import": {
        "types": "./dist/browser-rendering/index.d.ts",
        "default": "./dist/browser-rendering/index.js"
      },
      "default": "./src/browser-rendering/index.ts"
    }
  },
  "scripts": {
    "build": "tsup && pnpm build:types",
    "dev": "tsup --watch",
    "check": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "test:acceptance": "vitest run acceptance --environment jsdom",
    "build:types": "tsc -b tsconfig.json --force"
  },
  "dependencies": {
    "@sweatpants/agent-host": "workspace:*",
    "@sweatpants/chat-core": "workspace:*",
    "@sweatpants/durable-chat-runtime": "workspace:*",
    "@sweatpants/tool-session": "workspace:*",
    "effection": "catalog:"
  },
  "devDependencies": {
    "@effectionx/raf": "catalog:",
    "@sweatpants/agent-sdk": "workspace:*",
    "@sweatpants/test-rig": "workspace:*",
    "@sweatpants/tool-runtime-local": "workspace:*",
    "@sweatpants/ts-config": "workspace:*",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "effection": "catalog:",
    "katex": "^0.16.27",
    "marked": "^17.0.1",
    "mermaid": "^11.12.2",
    "react": "catalog:",
    "shiki": "^3.20.0",
    "tailwind-merge": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:",
    "@sweatpants/journal-authority": "workspace:*"
  },
  "peerDependencies": {
    "@effectionx/raf": "^0.1.1",
    "effection": ">=4.1.0-alpha.9 <5.0.0",
    "katex": "^0.16.27",
    "marked": "^17.0.1",
    "mermaid": "^11.12.2",
    "react": "^19.0.0",
    "shiki": "^3.20.0",
    "tailwind-merge": "^2.5.2"
  }
}
