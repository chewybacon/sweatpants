{
  "name": "@sweatpants/react-chat",
  "version": "0.1.0",
  "description": "React adapter for Sweatpants chat applications",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": {
        "import": "./src/index.ts",
        "types": "./src/index.ts"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup && pnpm build:types",
    "dev": "tsup --watch",
    "check": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "test:acceptance": "vitest run acceptance",
    "build:types": "tsc -b tsconfig.json --force",
    "lint": "cd ../.. && oxlint --type-aware packages/react-chat",
    "lint:fix": "cd ../.. && oxlint --type-aware packages/react-chat --fix",
    "format": "cd ../.. && oxfmt packages/react-chat",
    "format:check": "cd ../.. && oxfmt packages/react-chat --check",
    "build:clean": "tsx ../../scripts/clean-build.ts ."
  },
  "dependencies": {
    "@sweatpants/chat-client": "workspace:*",
    "@sweatpants/foundation": "workspace:*",
    "@sweatpants/frame-renderer": "workspace:*",
    "@sweatpants/tool-session": "workspace:*",
    "effection": "catalog:"
  },
  "devDependencies": {
    "@effectionx/raf": "catalog:",
    "@sweatpants/agent-sdk": "workspace:*",
    "@sweatpants/ts-config": "workspace:*",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "effection": "catalog:",
    "react": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effection": ">=4.2.0 <5.0.0",
    "react": "^19.0.0"
  }
}
