{
  "name": "@sweatpants/frame-renderer",
  "version": "0.1.0",
  "description": "Demand-driven streaming frames with extensible Markdown, math, code, and diagram rendering",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    "./frame": {
      "development": {
        "import": "./src/frame.ts",
        "types": "./src/frame.ts"
      },
      "import": {
        "types": "./dist/frame.d.ts",
        "default": "./dist/frame.js"
      },
      "require": {
        "types": "./dist/frame.d.ts",
        "default": "./dist/frame.cjs"
      }
    },
    ".": {
      "development": {
        "import": "./src/index.ts",
        "types": "./src/index.ts"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      },
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup && pnpm build:types",
    "dev": "tsup --watch",
    "check": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "build:types": "tsc -b tsconfig.json --force"
  },
  "dependencies": {
    "effection": "catalog:",
    "katex": "^0.16.27",
    "marked": "^17.0.1",
    "mermaid": "^11.12.2",
    "shiki": "^3.20.0"
  },
  "devDependencies": {
    "@sweatpants/ts-config": "workspace:*",
    "@types/katex": "^0.16.7",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
