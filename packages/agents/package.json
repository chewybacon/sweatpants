{
  "name": "@sweatpants/agents",
  "version": "0.1.0",
  "description": "Unified agent model: agents as callable coroutines on a shared durable stream with protocol-neutral fulfillment",
  "type": "module",
  "exports": {
    ".": {
      "development": {
        "import": "./src/index.ts",
        "types": "./src/index.ts"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check": "tsc -b",
    "test": "vitest",
    "test:acceptance": "vitest run acceptance"
  },
  "dependencies": {
    "@sweatpants/core": "workspace:*",
    "@sweatpants/durable-streams": "workspace:*",
    "@sweatpants/framework": "workspace:*",
    "effection": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@effectionx/vitest": "catalog:",
    "@sweatpants/ts-config": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "MIT"
}
