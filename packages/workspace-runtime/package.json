{
    "name": "@sweatpants/workspace-runtime",
    "version": "0.1.0",
    "description": "Fenced finite-HTTP workspace service and Host connector",
    "license": "MIT",
    "files": [
        "dist",
        "src"
    ],
    "type": "module",
    "exports": {
        ".": {
            "development": {
                "import": "./src/index.ts",
                "types": "./src/index.ts"
            },
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        },
        "./api": {
            "development": {
                "import": "./src/api.ts",
                "types": "./src/api.ts"
            },
            "import": {
                "types": "./dist/api.d.ts",
                "default": "./dist/api.js"
            }
        }
    },
    "scripts": {
        "build": "tsup",
        "check": "tsc -b",
        "test": "vitest run"
    },
    "dependencies": {
        "@sweatpants/session-contract": "workspace:*",
        "effection": "catalog:"
    },
    "devDependencies": {
        "@sweatpants/ts-config": "workspace:*",
        "@types/node": "catalog:",
        "tsup": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
