{
  "name": "@sweatpants/workspace-runtime",
  "version": "0.1.0",
  "description": "Fenced finite-HTTP workspace service and Host connector",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": {
        "import": "./src/index.ts",
        "types": "./src/index.ts"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./api": {
      "development": {
        "import": "./src/api.ts",
        "types": "./src/api.ts"
      },
      "import": {
        "types": "./dist/api.d.ts",
        "default": "./dist/api.js"
      }
    },
    "./testing": {
      "development": {
        "import": "./src/testing.ts",
        "types": "./src/testing.ts"
      },
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "default": "./src/testing.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "check": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "lint": "cd ../.. && oxlint --type-aware packages/workspace-runtime",
    "lint:fix": "cd ../.. && oxlint --type-aware packages/workspace-runtime --fix",
    "format": "cd ../.. && oxfmt packages/workspace-runtime",
    "format:check": "cd ../.. && oxfmt packages/workspace-runtime --check",
    "build:clean": "tsx ../../scripts/clean-build.ts ."
  },
  "dependencies": {
    "@sweatpants/durable-execution": "workspace:*",
    "@sweatpants/foundation": "workspace:*",
    "@sweatpants/journal-authority": "workspace:*",
    "effection": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@sweatpants/tool-session": "workspace:*",
    "@sweatpants/ts-config": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
