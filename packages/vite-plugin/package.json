{
  "name": "@sweatpants/vite-plugin",
  "version": "0.1.0",
  "description": "Vite integration for Sweatpants tool discovery and generated registries",
  "type": "module",
  "exports": {
    ".": {
      "development": {
        "import": "./src/index.ts",
        "types": "./src/index.ts"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check": "tsc -b",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "zod": "^3.24.0 || ^4.0.0"
  },
  "dependencies": {
    "fast-glob": "^3.3.2",
    "magic-string": "catalog:",
    "@babel/core": "^7.24.0"
  },
  "devDependencies": {
    "@sweatpants/ts-config": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:",
    "@babel/preset-typescript": "^7.24.0",
    "@babel/types": "^7.24.0",
    "@types/babel__core": "^7.20.5"
  },
  "license": "MIT"
}
