{
    "name": "@sweatpants/vite-plugin",
    "version": "0.1.0",
    "description": "Vite integration for client tool contracts, tool discovery, and generated registries",
    "license": "MIT",
    "files": [
        "dist",
        "src"
    ],
    "type": "module",
    "exports": {
        ".": {
            "development": {
                "import": "./src/index.ts",
                "types": "./src/index.ts"
            },
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "scripts": {
        "build": "tsup && pnpm build:types",
        "dev": "tsup --watch",
        "check": "tsc -b",
        "test": "vitest run --passWithNoTests",
        "build:types": "tsc -b tsconfig.json --force"
    },
    "dependencies": {
        "@babel/core": "^7.24.0",
        "@sweatpants/tool-runtime-local": "workspace:*",
        "fast-glob": "^3.3.2",
        "magic-string": "catalog:"
    },
    "devDependencies": {
        "@babel/preset-typescript": "^7.24.0",
        "@sweatpants/agent-sdk": "workspace:*",
        "@sweatpants/ts-config": "workspace:*",
        "@types/babel__core": "^7.20.5",
        "@types/node": "catalog:",
        "tsup": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:",
        "zod": "catalog:"
    },
    "peerDependencies": {
        "vite": "^5.0.0 || ^6.0.0 || ^7.0.0",
        "zod": "^3.24.0 || ^4.0.0"
    }
}
