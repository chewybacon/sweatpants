{
  "name": "@sweatpants/elicit-context",
  "version": "0.1.0",
  "description": "x-elicit-context specification and utilities for MCP elicitation",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup && rm -f tsconfig.tsbuildinfo && tsc -p tsconfig.json --emitDeclarationOnly --declarationMap --declaration --outDir dist",
    "check": "tsc -b"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "mcp",
    "elicit",
    "context",
    "model-context-protocol"
  ],
  "author": "Sweatpants",
  "license": "MIT"
}
