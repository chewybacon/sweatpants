{
    "name": "@sweatpants/elicit-context",
    "version": "0.1.0",
    "description": "x-elicit-context specification and utilities for MCP elicitation",
    "keywords": [
        "context",
        "elicit",
        "mcp",
        "model-context-protocol"
    ],
    "license": "MIT",
    "author": "Sweatpants",
    "files": [
        "dist",
        "src"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "development": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsup && rm -f tsconfig.tsbuildinfo && tsc -p tsconfig.json --emitDeclarationOnly --declarationMap --declaration --outDir dist",
        "check": "tsc -b"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "tsup": "^8.0.0",
        "typescript": "^5.3.0"
    }
}
