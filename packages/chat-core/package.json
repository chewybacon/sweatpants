{
    "name": "@sweatpants/chat-core",
    "version": "0.1.0",
    "description": "Chat messages, Turn state, authoring, personas, model contracts, and portable codecs",
    "license": "MIT",
    "files": [
        "dist",
        "src"
    ],
    "type": "module",
    "exports": {
        ".": {
            "development": {
                "import": "./src/index.ts",
                "types": "./src/index.ts"
            },
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "default": "./src/index.ts"
        }
    },
    "scripts": {
        "build": "tsup && tsc -b --force",
        "check": "tsc -b",
        "test": "vitest run"
    },
    "dependencies": {
        "@sweatpants/agent-sdk": "workspace:*",
        "@sweatpants/durable-effects": "workspace:*",
        "@sweatpants/durable-execution": "workspace:*",
        "@sweatpants/foundation": "workspace:*",
        "@sweatpants/model-provider": "workspace:*",
        "effection": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@sweatpants/journal-authority": "workspace:*",
        "@sweatpants/ts-config": "workspace:*",
        "@types/node": "catalog:",
        "tsup": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
