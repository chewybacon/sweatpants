{
  "name": "@sweatpants/tool-runtime-cloudflare",
  "version": "0.1.0",
  "description": "Cloudflare Worker and Durable Object execution placement for tools",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": {
        "import": "./src/index.ts",
        "types": "./src/index.ts"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./executor": {
      "development": {
        "import": "./src/executor.ts",
        "types": "./src/executor.ts"
      },
      "import": {
        "types": "./dist/executor.d.ts",
        "default": "./dist/executor.js"
      }
    },
    "./sessions": {
      "development": {
        "import": "./src/sessions.ts",
        "types": "./src/sessions.ts"
      },
      "import": {
        "types": "./dist/sessions.d.ts",
        "default": "./dist/sessions.js"
      }
    }
  },
  "scripts": {
    "build": "tsup && tsc -b --force",
    "check": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@cloudflare/workers-types": "5.20261005.1",
    "@sweatpants/agent-sdk": "workspace:*",
    "@sweatpants/durable-execution": "workspace:*",
    "@sweatpants/foundation": "workspace:*",
    "@sweatpants/journal-authority": "workspace:*",
    "@sweatpants/tool-session": "workspace:*",
    "effection": "catalog:"
  },
  "devDependencies": {
    "@sweatpants/ts-config": "workspace:*",
    "esbuild": "0.27.2",
    "miniflare": "5.20261001.0-alpha",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
