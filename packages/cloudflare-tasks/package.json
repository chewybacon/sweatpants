{
  "name": "@sweatpants/cloudflare-tasks",
  "version": "0.1.0",
  "description": "Run maintenance and seed tasks with Wrangler bindings",
  "license": "MIT",
  "bin": {
    "cf-task": "./bin/cf-task.mjs"
  },
  "files": [
    "dist",
    "src",
    "bin"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": {
        "import": "./src/index.ts",
        "types": "./src/index.ts"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup && tsc -b --force",
    "check": "tsc -b && tsc -p tsconfig.test.json",
    "test": "tsup && vitest run",
    "lint": "cd ../.. && oxlint --type-aware packages/cloudflare-tasks",
    "lint:fix": "cd ../.. && oxlint --type-aware packages/cloudflare-tasks --fix",
    "format": "cd ../.. && oxfmt packages/cloudflare-tasks",
    "format:check": "cd ../.. && oxfmt packages/cloudflare-tasks --check",
    "build:clean": "tsx ../../scripts/clean-build.ts ."
  },
  "dependencies": {
    "tsx": "catalog:",
    "wrangler": "4.147.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261005.1",
    "@sweatpants/ts-config": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
