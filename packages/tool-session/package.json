{
    "name": "@sweatpants/tool-session",
    "version": "0.1.0",
    "description": "Protocol-neutral durable tool-session contracts and event log",
    "license": "MIT",
    "files": [
        "dist",
        "src"
    ],
    "type": "module",
    "exports": {
        ".": {
            "development": {
                "import": "./src/index.ts",
                "types": "./src/index.ts"
            },
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        },
        "./contract": {
            "development": {
                "import": "./src/contract.ts",
                "types": "./src/contract.ts"
            },
            "import": {
                "types": "./dist/contract.d.ts",
                "default": "./dist/contract.js"
            }
        },
        "./event-log": {
            "development": {
                "import": "./src/event-log.ts",
                "types": "./src/event-log.ts"
            },
            "import": {
                "types": "./dist/event-log.d.ts",
                "default": "./dist/event-log.js"
            }
        }
    },
    "scripts": {
        "build": "tsup && tsc -b --force",
        "check": "tsc -b",
        "test": "vitest run"
    },
    "dependencies": {
        "@sweatpants/core": "workspace:*",
        "effection": "catalog:"
    },
    "devDependencies": {
        "@sweatpants/ts-config": "workspace:*",
        "@types/node": "catalog:",
        "tsup": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
