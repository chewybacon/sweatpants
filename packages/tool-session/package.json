{
  "name": "@sweatpants/tool-session",
  "version": "0.1.0",
  "description": "Protocol-neutral durable tool-session contracts and event log",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": {
        "import": "./src/index.ts",
        "types": "./src/index.ts"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./contract": {
      "development": {
        "import": "./src/contract.ts",
        "types": "./src/contract.ts"
      },
      "import": {
        "types": "./dist/contract.d.ts",
        "default": "./dist/contract.js"
      }
    },
    "./event-log": {
      "development": {
        "import": "./src/event-log.ts",
        "types": "./src/event-log.ts"
      },
      "import": {
        "types": "./dist/event-log.d.ts",
        "default": "./dist/event-log.js"
      }
    },
    "./ephemeral": {
      "development": {
        "import": "./src/ephemeral.ts",
        "types": "./src/ephemeral.ts"
      },
      "import": {
        "types": "./dist/ephemeral.d.ts",
        "default": "./dist/ephemeral.js"
      },
      "default": "./src/ephemeral.ts"
    },
    "./elicit-context": {
      "development": {
        "import": "./src/elicit-context/index.ts",
        "types": "./src/elicit-context/index.ts"
      },
      "import": {
        "types": "./dist/elicit-context/index.d.ts",
        "default": "./dist/elicit-context/index.js"
      },
      "default": "./src/elicit-context/index.ts"
    },
    "./mcp": {
      "development": {
        "import": "./src/mcp/index.ts",
        "types": "./src/mcp/index.ts"
      },
      "import": {
        "types": "./dist/mcp/index.d.ts",
        "default": "./dist/mcp/index.js"
      },
      "default": "./src/mcp/index.ts"
    },
    "./tool-parameters": {
      "development": {
        "import": "./src/tool-parameters.ts",
        "types": "./src/tool-parameters.ts"
      },
      "import": {
        "types": "./dist/tool-parameters.d.ts",
        "default": "./dist/tool-parameters.js"
      },
      "default": "./src/tool-parameters.ts"
    },
    "./messages": {
      "development": {
        "import": "./src/messages.ts",
        "types": "./src/messages.ts"
      },
      "import": {
        "types": "./dist/messages.d.ts",
        "default": "./dist/messages.js"
      },
      "default": "./src/messages.ts"
    },
    "./execution": {
      "development": {
        "import": "./src/execution/index.ts",
        "types": "./src/execution/index.ts"
      },
      "import": {
        "types": "./dist/execution/index.d.ts",
        "default": "./dist/execution/index.js"
      }
    },
    "./invocation-execution": {
      "development": {
        "import": "./src/tool-invocation-execution.ts",
        "types": "./src/tool-invocation-execution.ts"
      },
      "import": {
        "types": "./dist/tool-invocation-execution.d.ts",
        "default": "./dist/invocation-execution.js"
      }
    }
  },
  "scripts": {
    "build": "tsup && tsc -b --force",
    "check": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "lint": "cd ../.. && oxlint --type-aware packages/tool-session",
    "lint:fix": "cd ../.. && oxlint --type-aware packages/tool-session --fix",
    "format": "cd ../.. && oxfmt packages/tool-session",
    "format:check": "cd ../.. && oxfmt packages/tool-session --check",
    "build:clean": "tsx ../../scripts/clean-build.ts ."
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:",
    "@sweatpants/agent-sdk": "workspace:*",
    "@sweatpants/chat-contract": "workspace:*",
    "@sweatpants/durable-effects": "workspace:*",
    "@sweatpants/durable-execution": "workspace:*",
    "@sweatpants/foundation": "workspace:*",
    "@sweatpants/model-provider": "workspace:*",
    "@sweatpants/model-sampling": "workspace:*",
    "@sweatpants/tool-runtime": "workspace:*",
    "base64-js": "1.5.1",
    "effection": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@sweatpants/ts-config": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
