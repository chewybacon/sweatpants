{
    "name": "@sweatpants/tool-session",
    "version": "0.1.0",
    "description": "Protocol-neutral durable tool-session contracts and event log",
    "license": "MIT",
    "files": [
        "dist",
        "src"
    ],
    "type": "module",
    "exports": {
        ".": {
            "development": {
                "import": "./src/index.ts",
                "types": "./src/index.ts"
            },
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        },
        "./contract": {
            "development": {
                "import": "./src/contract.ts",
                "types": "./src/contract.ts"
            },
            "import": {
                "types": "./dist/contract.d.ts",
                "default": "./dist/contract.js"
            }
        },
        "./event-log": {
            "development": {
                "import": "./src/event-log.ts",
                "types": "./src/event-log.ts"
            },
            "import": {
                "types": "./dist/event-log.d.ts",
                "default": "./dist/event-log.js"
            }
        },
        "./foreign": {
            "development": {
                "import": "./src/foreign.ts",
                "types": "./src/foreign.ts"
            },
            "import": {
                "types": "./dist/foreign.d.ts",
                "default": "./dist/foreign.js"
            },
            "default": "./src/foreign.ts"
        },
        "./elicit-context": {
            "development": {
                "import": "./src/elicit-context/index.ts",
                "types": "./src/elicit-context/index.ts"
            },
            "import": {
                "types": "./dist/elicit-context/index.d.ts",
                "default": "./dist/elicit-context/index.js"
            },
            "default": "./src/elicit-context/index.ts"
        },
        "./mcp": {
            "development": {
                "import": "./src/mcp/index.ts",
                "types": "./src/mcp/index.ts"
            },
            "import": {
                "types": "./dist/mcp/index.d.ts",
                "default": "./dist/mcp/index.js"
            },
            "default": "./src/mcp/index.ts"
        },
        "./tool-parameters": {
            "development": {
                "import": "./src/tool-parameters.ts",
                "types": "./src/tool-parameters.ts"
            },
            "import": {
                "types": "./dist/tool-parameters.d.ts",
                "default": "./dist/tool-parameters.js"
            },
            "default": "./src/tool-parameters.ts"
        },
        "./chat-runtime": {
            "development": {
                "import": "./src/chat-runtime.ts",
                "types": "./src/chat-runtime.ts"
            },
            "import": {
                "types": "./dist/chat-runtime.d.ts",
                "default": "./dist/chat-runtime.js"
            },
            "default": "./src/chat-runtime.ts"
        },
        "./tool-inventory": {
            "development": {
                "import": "./src/tool-inventory.ts",
                "types": "./src/tool-inventory.ts"
            },
            "import": {
                "types": "./dist/tool-inventory.d.ts",
                "default": "./dist/tool-inventory.js"
            },
            "default": "./src/tool-inventory.ts"
        },
        "./messages": {
            "development": {
                "import": "./src/messages.ts",
                "types": "./src/messages.ts"
            },
            "import": {
                "types": "./dist/messages.d.ts",
                "default": "./dist/messages.js"
            },
            "default": "./src/messages.ts"
        }
    },
    "scripts": {
        "build": "tsup && tsc -b --force",
        "check": "tsc -b",
        "test": "vitest run"
    },
    "dependencies": {
        "@standard-schema/spec": "catalog:",
        "@sweatpants/agent-sdk": "workspace:*",
        "@sweatpants/durable-effects": "workspace:*",
        "@sweatpants/durable-execution": "workspace:*",
        "@sweatpants/foundation": "workspace:*",
        "@sweatpants/model-provider": "workspace:*",
        "effection": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@sweatpants/ts-config": "workspace:*",
        "@types/node": "catalog:",
        "tsup": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
