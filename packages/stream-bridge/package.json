{
  "name": "@sweatpants/stream-bridge",
  "version": "0.0.1-experimental",
  "description": "Experimental: bridging Effection streams to HTTP responses",
  "type": "module",
  "exports": {
    ".": {
      "development": {
        "import": "./src/index.ts",
        "types": "./src/index.ts"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./approaches/readable-stream-bridge": {
      "development": {
        "import": "./src/approaches/readable-stream-bridge.ts",
        "types": "./src/approaches/readable-stream-bridge.ts"
      },
      "import": {
        "types": "./dist/approaches/readable-stream-bridge.d.ts",
        "default": "./dist/approaches/readable-stream-bridge.js"
      }
    },
    "./approaches/async-iterable-response": {
      "development": {
        "import": "./src/approaches/async-iterable-response.ts",
        "types": "./src/approaches/async-iterable-response.ts"
      },
      "import": {
        "types": "./dist/approaches/async-iterable-response.d.ts",
        "default": "./dist/approaches/async-iterable-response.js"
      }
    },
    "./approaches/scope-captured-stream": {
      "development": {
        "import": "./src/approaches/scope-captured-stream.ts",
        "types": "./src/approaches/scope-captured-stream.ts"
      },
      "import": {
        "types": "./dist/approaches/scope-captured-stream.d.ts",
        "default": "./dist/approaches/scope-captured-stream.js"
      }
    },
    "./approaches/effection-server": {
      "development": {
        "import": "./src/approaches/effection-server.ts",
        "types": "./src/approaches/effection-server.ts"
      },
      "import": {
        "types": "./dist/approaches/effection-server.d.ts",
        "default": "./dist/approaches/effection-server.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check": "tsc -b",
    "test": "vitest"
  },
  "dependencies": {
    "effection": "catalog:"
  },
  "devDependencies": {
    "@sweatpants/ts-config": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "MIT"
}
