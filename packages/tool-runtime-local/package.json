{
  "name": "@sweatpants/tool-runtime-local",
  "version": "0.1.0",
  "description": "Local and worker-backed tool runtime for Sweatpants chat",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": {
        "import": "./src/index.ts",
        "types": "./src/index.ts"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./worker": {
      "development": {
        "import": "./src/worker.ts",
        "types": "./src/worker.ts"
      },
      "import": {
        "types": "./dist/worker.d.ts",
        "default": "./dist/worker.js"
      },
      "require": {
        "types": "./dist/worker.d.ts",
        "default": "./dist/worker.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup && pnpm build:types",
    "dev": "tsup --watch",
    "check": "tsc -b",
    "test": "vitest run src",
    "build:types": "tsc -b tsconfig.json --force"
  },
  "dependencies": {
    "@effectionx/worker": "catalog:",
    "@standard-schema/spec": "catalog:",
    "@sweatpants/agent-sdk": "workspace:*",
    "@sweatpants/chat-contract": "workspace:*",
    "@sweatpants/chat-core": "workspace:*",
    "@sweatpants/durable-effects": "workspace:*",
    "@sweatpants/durable-execution": "workspace:*",
    "@sweatpants/foundation": "workspace:*",
    "@sweatpants/journal-authority": "workspace:*",
    "@sweatpants/model-provider": "workspace:*",
    "@sweatpants/model-sampling": "workspace:*",
    "@sweatpants/tool-runtime": "workspace:*",
    "@sweatpants/tool-session": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@sweatpants/durable-chat-runtime": "workspace:*",
    "@sweatpants/ts-config": "workspace:*",
    "@types/node": "catalog:",
    "effection": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effection": ">=4.2.0 <5.0.0"
  }
}
