{
  "name": "sweatpants",
  "version": "0.1.0",
  "description": "AI Chat Framework - Build interactive chat applications with streaming, tools, and durable sessions",
  "license": "MIT",
  "scripts": {
    "lint": "pnpm -r --workspace-concurrency=1 --if-present run lint",
    "lint:fix": "pnpm -r --workspace-concurrency=1 --if-present run lint:fix",
    "format": "pnpm -r --workspace-concurrency=1 --if-present run format",
    "format:check": "pnpm -r --workspace-concurrency=1 --if-present run format:check",
    "build": "pnpm -r --workspace-concurrency=1 --if-present run build",
    "build:clean": "pnpm -r --workspace-concurrency=1 --if-present run build:clean",
    "build:check": "pnpm -r --workspace-concurrency=1 --if-present run build:check",
    "build:verify": "pnpm build:clean && pnpm build && pnpm build:check",
    "check": "pnpm -r --workspace-concurrency=4 --if-present run check",
    "check:change": "tsx scripts/verify-change.ts",
    "check:hygiene": "pnpm -r --workspace-concurrency=1 --if-present run check:hygiene",
    "check:evidence": "pnpm -r --workspace-concurrency=1 --if-present run check:evidence",
    "check:evidence:closure": "pnpm -r --workspace-concurrency=1 --if-present run check:evidence:closure",
    "test": "CI=1 VITEST_MAX_THREADS=1 VITEST_MIN_THREADS=1 VITEST_MAX_FORKS=1 VITEST_MIN_FORKS=1 pnpm -r --workspace-concurrency=1 --if-present run test",
    "test:execution-recovery": "NODE_OPTIONS=--conditions=development node --import tsx experiments/workflow-kernel/recovery-middleware/__tests__/recovery.mjs && NODE_OPTIONS=--conditions=development node --import tsx experiments/workflow-kernel/executor-recovery/__tests__/recovery.mjs && NODE_OPTIONS=--conditions=development node --import tsx experiments/workflow-kernel/executor-recovery/__tests__/host.mjs",
    "dev": "pnpm -r --parallel --if-present run dev",
    "land": "tsx scripts/land.ts deterministic",
    "land:live": "tsx scripts/land.ts live",
    "land:full": "tsx scripts/land.ts full"
  },
  "dependencies": {
    "@effectionx/context-api": "catalog:",
    "effection": "catalog:"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.1",
    "@standard-schema/spec": "catalog:",
    "@sweatpants/agent-sdk": "workspace:*",
    "@sweatpants/durable-execution": "workspace:*",
    "@sweatpants/flowmode-runtime": "workspace:*",
    "@sweatpants/foundation": "workspace:*",
    "@sweatpants/history-store": "workspace:*",
    "@sweatpants/journal-authority": "workspace:*",
    "@sweatpants/standard-durability": "workspace:*",
    "@sweatpants/standard-durability-effect": "workspace:*",
    "@sweatpants/standard-durability-effection": "workspace:*",
    "@sweatpants/ts-config": "workspace:*",
    "@types/node": "catalog:",
    "effect": "^4.0.6",
    "fallow": "3.19.0",
    "oxc-parser": "^0.123.0",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-api": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=24.22.0"
  },
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "overrides": {
      "@effectionx/signals": "^0.5.3",
      "@effectionx/timebox": "^0.4.3",
      "effection": "4.2.0",
      "@babel/types": "7.29.8"
    },
    "patchedDependencies": {
      "@effectionx/worker@0.5.2": "patches/@effectionx__worker@0.5.2.patch"
    }
  }
}
