{
    "name": "sweatpants",
    "version": "0.1.0",
    "description": "AI Chat Framework - Build interactive chat applications with streaming, tools, and durable sessions",
    "license": "MIT",
    "scripts": {
        "dev": "pnpm run -r --parallel --aggregate-output dev",
        "dev:yo-chat": "tsx scripts/dev-yo-chat.ts",
        "dev:yo-chat:local": "DEFAULT_CHAT_MODEL_PROVIDER=${DEFAULT_CHAT_MODEL_PROVIDER:-ollama} DEFAULT_CHAT_MODEL_ID=${DEFAULT_CHAT_MODEL_ID:-gemma4:12b-mlx} MCP_TOOL_RUNTIME=local pnpm -C apps/yo-chat dev",
        "dev:yo-chat:agentcore": "DEFAULT_CHAT_MODEL_PROVIDER=${DEFAULT_CHAT_MODEL_PROVIDER:-amazon-bedrock} DEFAULT_CHAT_MODEL_ID=${DEFAULT_CHAT_MODEL_ID:-zai.glm-5} AWS_REGION=${AWS_REGION:-us-east-1} MCP_TOOL_RUNTIME=agentcore pnpm -C apps/yo-chat dev",
        "dev:yo-chat:agentcore:auto": "./scripts/launch-yo-chat-agentcore.sh",
        "dev:yo-chat:remote": "./scripts/launch-yo-chat-remote.sh",
        "build": "pnpm run -r build && pnpm validate:exports && pnpm validate:product-surface",
        "clean:build": "tsx scripts/clean-build.ts",
        "verify:clean-build": "pnpm clean:build && pnpm build",
        "test": "pnpm run -r --workspace-concurrency=1 test",
        "test:tooling": "vitest run --config vitest.scripts.config.ts",
        "check:tests": "./scripts/check-tests.sh",
        "check:hygiene": "tsx scripts/workspace-hygiene.ts",
        "check:evidence": "tsx scripts/campaign-evidence.ts",
        "test:e2e": "pnpm -C apps/yo-chat test:e2e && pnpm -C apps/yo-mcp test",
        "test:e2e:optional": "pnpm -C apps/yo-chat test:e2e",
        "test:e2e:manual": "pnpm -C apps/yo-chat test:e2e:manual",
        "test:e2e:manual:ui": "pnpm -C apps/yo-chat test:e2e:manual:ui",
        "test:yo-chat:e2e": "tsx scripts/yo-chat-e2e.ts",
        "land": "tsx scripts/land.ts deterministic",
        "land:live": "tsx scripts/land.ts live",
        "land:full": "tsx scripts/land.ts full",
        "test:outside-in": "pnpm -C apps/yo-chat test:outside-in",
        "test:outside-in:tier-a": "pnpm -C apps/yo-chat test:outside-in:tier-a",
        "test:outside-in:hermetic": "pnpm -C apps/yo-chat test:outside-in:hermetic",
        "lint": "./node_modules/.bin/oxlint --type-aware --import-plugin --react-plugin --promise-plugin --vitest-plugin . && pnpm run -r --parallel lint",
        "lint:fix": "./node_modules/.bin/oxlint --import-plugin --react-plugin --promise-plugin --vitest-plugin --fix .",
        "format": "./node_modules/.bin/oxfmt .",
        "format:check": "./node_modules/.bin/oxfmt --check .",
        "fallow:complexity": "fallow health --complexity --sort cognitive --top 30",
        "fallow:hotspots": "fallow health --hotspots --since 1y --min-commits 2",
        "fallow:targets": "fallow health --targets",
        "fallow:dead-code": "fallow dead-code --type-aware",
        "fallow:audit": "fallow audit",
        "check": "tsc -b",
        "check:apps": "pnpm --filter './apps/**' --workspace-concurrency=3 --aggregate-output --if-present run check",
        "validate:exports": "tsx scripts/validate-package-exports.ts",
        "validate:product-surface": "tsx scripts/validate-product-surface.ts",
        "verify:yo-chat-remote-collection": "tsx scripts/verify-yo-chat-remote-collection.mts",
        "publish:yo-chat-remote-collection": "tsx scripts/publish-yo-chat-remote-collection.mts",
        "activate:yo-chat-remote-collection": "tsx scripts/activate-yo-chat-remote-collection.mts",
        "model:auth": "tsx scripts/model-auth.ts status",
        "model:auth:status": "tsx scripts/model-auth.ts status",
        "model:auth:login": "tsx scripts/model-auth.ts login",
        "model:auth:refresh": "tsx scripts/model-auth.ts refresh",
        "model:auth:logout": "tsx scripts/model-auth.ts logout",
        "model:auth:use": "tsx scripts/model-auth.ts use",
        "model:auth:selection": "tsx scripts/model-auth.ts selection",
        "model:auth:providers": "tsx scripts/model-auth.ts providers",
        "pull:gemini-cli": "rm -rf apps/yo-agent/packages/gemini-cli && git clone --depth 1 https://github.com/google-gemini/gemini-cli.git apps/yo-agent/packages/gemini-cli && rm -rf apps/yo-agent/packages/gemini-cli/.git"
    },
    "dependencies": {
        "@effectionx/context-api": "catalog:",
        "effection": "catalog:"
    },
    "devDependencies": {
        "@earendil-works/pi-ai": "0.84.0",
        "@sweatpants/durable-execution": "workspace:*",
        "@sweatpants/foundation": "workspace:*",
        "@sweatpants/history-store": "workspace:*",
        "@sweatpants/journal-authority": "workspace:*",
        "@sweatpants/ts-config": "workspace:*",
        "@types/node": "catalog:",
        "fallow": "3.19.0",
        "oxc-parser": "^0.123.0",
        "oxfmt": "^0.43.0",
        "oxlint": "^1.58.0",
        "oxlint-tsgolint": "^7.0.2001",
        "tsx": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "packageManager": "pnpm@10.24.0",
    "pnpm": {
        "overrides": {
            "@effectionx/signals": "^0.5.3",
            "@effectionx/timebox": "^0.4.3",
            "effection": "4.1.0-alpha.9"
        }
    }
}
