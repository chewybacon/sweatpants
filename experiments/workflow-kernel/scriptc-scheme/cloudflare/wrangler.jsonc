{
  "name": "linked-workflow-local",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": { "bindings": [{ "name": "WORKFLOWS", "class_name": "LinkedWorkflow" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LinkedWorkflow"] }],
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
}
