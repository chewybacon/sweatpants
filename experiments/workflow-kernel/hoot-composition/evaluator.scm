;; Narrow explicit-state composition experiment. No native continuations are saved.
(use-modules (hoot control))
(define envs '())
(define next-env 0)
(define stack '())
(define mode 'eval)
(define control #f)
(define current-env 0)
(define pending #f)
(define outcome 'returned)
(define source-id "")
(define steps 0)
(define cancellation-requested #f)
(define (printed x) (call-with-output-string (lambda (p) (write x p))))
(define (read-one s) (call-with-input-string s (lambda (p) (read p))))
(define (read-all s)
  (call-with-input-string s
    (lambda (p) (let loop ((xs '()))
      (let ((x (read p))) (if (eof-object? x) (reverse xs) (loop (cons x xs))))))))
;; Environments are addressed records: closures share bindings through IDs.
(define (allocate parent bindings)
  (let ((id next-env))
    (set! next-env (+ next-env 1))
    (set! envs (cons (list id parent bindings) envs)) id))
(define (environment id) (or (assoc id envs) (error "Unknown environment" id)))
(define (bind! id name value)
  (let* ((e (environment id)) (old (assq name (caddr e))))
    (if old (set-cdr! old value)
        (set-car! (cddr e) (cons (cons name value) (caddr e))))))
(define (assign! id name value)
  (let* ((e (environment id)) (binding (assq name (caddr e))))
    (cond (binding (set-cdr! binding value))
          ((cadr e) (assign! (cadr e) name value))
          (else (error "Assignment to unbound name" name)))))
(define (lookup id name)
  (let* ((e (environment id)) (binding (assq name (caddr e))))
    (cond (binding (cdr binding))
          ((cadr e) (lookup (cadr e) name))
          ((memq name '(list object + - < > <= >= = not truthy js-add string-append equal? json-field)) (list 'primitive name))
          (else (error "Unbound workflow identifier" name)))))
(define (push frame) (set! stack (cons frame stack)))
(define (value x) (set! mode 'value) (set! control x))
(define (evaluate x env) (set! mode 'eval) (set! control x) (set! current-env env))
(define (sequence body env)
  (if (null? body) (value #f)
      (begin (push (list 'sequence (cdr body) env)) (evaluate (car body) env))))
(define (closure params body env name) (list 'closure params body env name))
(define (invoke proc args)
  (case (car proc)
    ((primitive)
     (value (case (cadr proc)
       ((object)
        (for-each (lambda (entry)
          (unless (and (list? entry) (= (length entry) 2) (string? (car entry)))
            (error "Invalid object entry"))) args)
        (cons 'json-object args))
       ((list) args) ((+) (apply + args)) ((-) (apply - args))
       ((<) (apply < args)) ((>) (apply > args))
       ((<=) (apply <= args)) ((>=) (apply >= args)) ((= equal?) (apply equal? args))
       ((not) (not (car args)))
       ((truthy) (let ((v (car args)))
         (not (or (eq? v #f) (eq? v 'json-null) (and (number? v) (= v 0)) (equal? v "")))))
       ((js-add) (if (and (number? (car args)) (number? (cadr args)))
                    (apply + args)
                    (apply string-append (map (lambda (v)
                      (if (string? v) v (number->string v))) args))))
       ((string-append) (apply string-append args))
       ((json-field)
        (unless (and (pair? (car args)) (eq? (caar args) 'json-object))
          (error "Expected JSON object"))
        (let ((entry (assoc (cadr args) (reverse (cdar args)))))
          (unless entry (error "Missing JSON field")) (cadr entry)))
       (else (error "Unsupported primitive")))))
    ((closure)
     (unless (= (length (cadr proc)) (length args)) (error "Wrong arity"))
     (let ((env (allocate (cadddr proc) (map cons (cadr proc) args))))
       ;; Ordinary function calls inherit the current logical scope.
       (push (list 'call (list-ref proc 4)))
       (sequence (caddr proc) env)))
    (else (error "Not a callable workflow value"))))
(define (register-cleanup proc)
  (let loop ((frames stack))
    (cond ((null? frames) (error "ensure outside a workflow scope"))
          ((eq? (caar frames) 'scope)
           (let ((frame (car frames)))
             (set-car! (cddr frame) (cons proc (caddr frame)))))
          ((eq? (caar frames) 'cleanup)
           (let ((frame (car frames)))
             (set-car! (cdr frame) (cons proc (cadr frame)))))
          (else (loop (cdr frames))))))
(define (cleaning?)
  (let loop ((frames stack))
    (and (pair? frames) (or (memq (caar frames) '(cleanup after-finally)) (loop (cdr frames))))))
;; Return targets calls; cancellation crosses calls and drains logical scopes.
(define (unwind kind result)
  (let loop ()
    (if (null? stack)
        (begin (set! outcome kind) (set! mode 'done) (set! control result))
        (let ((frame (car stack)))
          (set! stack (cdr stack))
          (case (car frame)
            ((call) (if (eq? kind 'returned) (value result) (loop)))
            ((finally) (run-finally frame kind result))
            ((scope) (clean (caddr frame) kind result))
            ((cleanup) (clean (cadr frame) kind result))
            ((loop)
             (case kind
               ((break) (value #f))
               ((continue) (loop-test (cadr frame) (caddr frame) (cadddr frame)))
               (else (loop))))
            (else (loop)))))))
(define (finish kind result)
  (cond ((and (eq? kind 'returned) cancellation-requested (not (cleaning?)))
         (unwind 'cancelled #f))
        ((eq? kind 'returned) (value result))
        (else (unwind kind result))))
(define (clean procs kind result)
  (if (null? procs) (finish kind result)
      (begin (push (list 'cleanup (cdr procs) kind result))
             (invoke (car procs) '()))))
;; Pending completions are data, including while cleanup itself is parked.
(define (run-finally frame kind result)
  (push (list 'after-finally kind result))
  (evaluate (cadr frame) (caddr frame)))
(define (finish-finally kind result)
  (cond ((and cancellation-requested (not (cleaning?)) (not (eq? kind 'thrown)))
         (unwind 'cancelled #f))
        ((eq? kind 'normal) (value result))
        (else (unwind kind result))))
(define (loop-test test body env)
  (push (list 'loop test body env 'test)) (evaluate test env))
(define (eval-step)
  (let ((x control) (env current-env))
    (cond
      ((symbol? x) (value (lookup env x)))
      ((not (pair? x)) (value x))
      (else
       (case (car x)
         ((quote) (value (cadr x)))
         ((begin) (sequence (cdr x) env))
         ((block) (sequence (cdr x) (allocate env '())))
         ((set!) (push (list 'assign (cadr x) env)) (evaluate (caddr x) env))
         ((while) (loop-test (cadr x) (caddr x) env))
         ((break) (unwind 'break #f))
         ((continue) (unwind 'continue #f))
         ((scope) (push (list 'open-scope (cadr x))) (evaluate (caddr x) env))
         ((lambda) (value (closure (cadr x) (cddr x) env 'lambda)))
         ((define)
          (if (pair? (cadr x))
              (begin (bind! env (caadr x) (closure (cdadr x) (cddr x) env (caadr x))) (value #f))
              (begin (push (list 'define (cadr x) env)) (evaluate (caddr x) env))))
         ((let)
          (evaluate (cons (cons 'lambda (cons (map car (cadr x)) (cddr x)))
                         (map cadr (cadr x))) env))
         ((if) (push (list 'if (caddr x) (cadddr x) env)) (evaluate (cadr x) env))
         ((try-finally) (push (list 'finally (caddr x) env)) (evaluate (cadr x) env))
         ((workflow-throw) (push (list 'throw)) (evaluate (cadr x) env))
         ((workflow-return) (push (list 'return)) (evaluate (cadr x) env))
         ((ensure) (push (list 'ensure)) (evaluate (cadr x) env))
         ((yield-at)
          (unless (string? (cadr x)) (error "Effect site must be a literal string"))
          (push (list 'yield (cadr x))) (evaluate (caddr x) env))
         (else (push (list 'operator (cdr x) env)) (evaluate (car x) env)))))))
(define (value-step)
  (if (null? stack)
      (begin (set! mode 'done) (set! outcome 'returned))
      (let ((frame (car stack)) (v control))
        (set! stack (cdr stack))
        (case (car frame)
          ((sequence) (if (null? (cadr frame)) (value v) (sequence (cadr frame) (caddr frame))))
          ((define) (bind! (caddr frame) (cadr frame) v) (value #f))
          ((assign) (assign! (caddr frame) (cadr frame) v) (value v))
          ((open-scope) (push (list 'scope (cadr frame) '())) (invoke v '()))
          ((scope) (clean (caddr frame) 'returned v))
          ((loop)
           (let ((test (cadr frame)) (body (caddr frame)) (env (cadddr frame)))
             (if (eq? (list-ref frame 4) 'test)
                 (if v (begin (push (list 'loop test body env 'body)) (evaluate body env)) (value #f))
                 (loop-test test body env))))
          ((if) (evaluate (if v (cadr frame) (caddr frame)) (cadddr frame)))
          ((operator)
           (if (null? (cadr frame)) (invoke v '())
               (begin (push (list 'argument v '() (cdadr frame) (caddr frame)))
                      (evaluate (caadr frame) (caddr frame)))))
          ((argument)
           (let ((args (cons v (caddr frame))) (rest (cadddr frame)) (env (list-ref frame 4)))
             (if (null? rest) (invoke (cadr frame) (reverse args))
                 (begin (push (list 'argument (cadr frame) args (cdr rest) env))
                        (evaluate (car rest) env)))))
          ((ensure) (register-cleanup v) (value #f))
          ((return) (unwind 'returned v))
          ((throw) (unwind 'thrown v))
          ((finally) (run-finally frame 'normal v))
          ((after-finally) (finish-finally (cadr frame) (caddr frame)))
          ((call) (value v))
          ((cleanup) (clean (cadr frame) (caddr frame) (cadddr frame)))
          ((yield) (set! pending (list (cadr frame) v)) (set! mode 'parked))
          (else (error "Unknown frame" (car frame)))))))
(define (boundary)
  (case mode
    ((parked) (values "effect" (car pending) (printed (cadr pending))))
    ((done) (values (symbol->string outcome) "" (printed control)))
    (else (error "Not at a boundary"))))
(define (drive)
  (let loop ((fuel 100000))
    (when (= fuel 0) (error "Workflow step budget exhausted"))
    (cond ((memq mode '(done parked)) (boundary))
          (else (set! steps (+ steps 1))
                (if (eq? mode 'eval) (eval-step) (value-step))
                (loop (- fuel 1))))))
(define (start source encoded-input)
  (set! source-id source) (set! envs '()) (set! next-env 0)
  (set! stack '()) (set! pending #f) (set! steps 0)
  (set! outcome 'returned) (set! cancellation-requested #f)
  (push (list 'scope 'root '()))
  (sequence (read-all source)
            (allocate #f (list (cons '%input (read-one encoded-input))))) (drive))
(define (resume encoded)
  (unless (eq? mode 'parked) (error "No pending effect"))
  (set! pending #f) (value (read-one encoded)) (drive))
(define (reject encoded)
  (unless (eq? mode 'parked) (error "No pending effect"))
  (set! pending #f) (unwind 'thrown (read-one encoded)) (drive))
(define (cancel)
  (unless (eq? mode 'parked) (error "No pending effect"))
  (set! cancellation-requested #t)
  (if (cleaning?) (boundary)
      (begin (set! pending #f) (unwind 'cancelled #f) (drive))))
(define (capture)
  (unless (memq mode '(parked done)) (error "Capture requires a boundary"))
  (printed (list 'workflow-state-v3 source-id envs next-env stack mode control
                 current-env pending outcome steps cancellation-requested)))
;; Validate the candidate before touching live state. This checks representation
;; integrity, not whether the state was reached by executing the pinned program.
(define (snapshot-error) (error "Invalid workflow snapshot"))
(define (shape? x n) (and (list? x) (= (length x) n)))
(define (natural? x) (and (exact-integer? x) (>= x 0)))
(define (all? predicate xs)
  (and (list? xs) (let loop ((xs xs))
    (or (null? xs) (and (predicate (car xs)) (loop (cdr xs)))))))
(define (validate-snapshot source encoded)
  ;; Bound reader input; the Wasm fuel budget also applies during validation.
  (unless (<= (string-length encoded) 4194304) (snapshot-error))
  (let ((s (call-with-input-string encoded
             (lambda (port)
               (let ((s (read port)))
                 (unless (eof-object? (read port)) (snapshot-error)) s)))))
    ;; Bound traversals before invoking list?/length on candidate structure.
    (let ((nodes 0))
      (let walk ((x s) (depth 0))
        (set! nodes (+ nodes 1))
        (unless (and (<= nodes 100000) (<= depth 256)) (snapshot-error))
        (if (pair? x)
            (begin (walk (car x) (+ depth 1)) (walk (cdr x) depth))
            (unless (or (null? x) (symbol? x) (string? x) (boolean? x)
                        (and (number? x) (rational? x))) (snapshot-error)))))
    (unless (and (shape? s 12) (eq? (car s) 'workflow-state-v3)
                 (equal? (cadr s) source) (memq (list-ref s 5) '(parked done))
                 (natural? (list-ref s 3)) (natural? (list-ref s 10))
                 (boolean? (list-ref s 11))
                 (memq (list-ref s 9) '(returned thrown cancelled)))
      (snapshot-error))
    (let* ((table (list-ref s 2)) (count (list-ref s 3))
           (frames (list-ref s 4)) (saved-mode (list-ref s 5))
           (saved-pending (list-ref s 8)))
      (define (env? id) (and (natural? id) (< id count)))
      (define (callable? proc)
        (and (pair? proc)
          (case (car proc)
            ((closure) (and (shape? proc 5) (all? symbol? (cadr proc))
                            (list? (caddr proc)) (env? (cadddr proc))
                            (symbol? (list-ref proc 4))))
            ((primitive) (and (shape? proc 2)
              (memq (cadr proc) '(list object + - < > <= >= = not truthy js-add string-append equal? json-field))))
            (else #f))))
      (define (portable? x)
        (or (string? x) (boolean? x) (and (number? x) (rational? x))
            (eq? x 'json-null)
            (and (list? x)
              (if (and (pair? x) (eq? (car x) 'json-object))
                  (all? (lambda (entry) (and (shape? entry 2) (string? (car entry))
                                            (portable? (cadr entry)))) (cdr x))
                  (all? portable? x)))))
      (define (completion? kind) (memq kind '(returned thrown cancelled break continue)))
      (define (frame? f)
        (and (pair? f) (list? f)
          (case (car f)
            ((sequence operator) (and (shape? f 3) (list? (cadr f)) (env? (caddr f))))
            ((define assign) (and (shape? f 3) (symbol? (cadr f)) (env? (caddr f))))
            ((if) (and (shape? f 4) (env? (cadddr f))))
            ((finally) (and (shape? f 3) (env? (caddr f))))
            ((loop) (and (shape? f 5) (env? (cadddr f)) (memq (list-ref f 4) '(test body))))
            ((argument) (and (shape? f 5) (callable? (cadr f))
                             (list? (caddr f)) (list? (cadddr f)) (env? (list-ref f 4))))
            ((scope) (and (shape? f 3) (all? callable? (caddr f))))
            ((cleanup) (and (shape? f 4) (all? callable? (cadr f)) (completion? (caddr f))))
            ((after-finally) (and (shape? f 3) (or (eq? (cadr f) 'normal) (completion? (cadr f)))))
            ((call) (and (shape? f 2) (symbol? (cadr f))))
            ((open-scope) (shape? f 2))
            ((yield) (and (shape? f 2) (string? (cadr f))))
            ((ensure return throw) (shape? f 1))
            (else #f))))
      (unless (and (> count 0) (list? table) (= (length table) count)
                   (env? (list-ref s 7)) (all? frame? frames)) (snapshot-error))
      ;; Allocation order gives unique contiguous IDs and acyclic parent links.
      (let loop ((entries table) (id (- count 1)))
        (unless (null? entries)
          (let ((e (car entries)))
            (unless (and (shape? e 3) (equal? (car e) id)
                         (if (= id 0) (eq? (cadr e) #f)
                             (and (env? (cadr e)) (< (cadr e) id)))
                         (list? (caddr e))) (snapshot-error))
            (let bindings ((xs (caddr e)) (names '()))
              (unless (null? xs)
                (let ((b (car xs)))
                  (unless (and (pair? b) (symbol? (car b)) (not (memq (car b) names)))
                    (snapshot-error))
                  (when (and (pair? (cdr b)) (memq (cadr b) '(closure primitive)))
                    (unless (callable? (cdr b)) (snapshot-error)))
                  (bindings (cdr xs) (cons (car b) names)))))
            (loop (cdr entries) (- id 1)))))
      (unless (if (eq? saved-mode 'parked)
                  (and (shape? saved-pending 2) (string? (car saved-pending))
                       (equal? (cadr saved-pending) (list-ref s 6))
                       (portable? (cadr saved-pending)))
                  (and (eq? saved-pending #f) (null? frames) (portable? (list-ref s 6))))
        (snapshot-error)))
    s))
(define (restore source encoded)
  (let ((s (validate-snapshot source encoded)))
    (set! source-id source) (set! envs (list-ref s 2)) (set! next-env (list-ref s 3))
    (set! stack (list-ref s 4)) (set! mode (list-ref s 5)) (set! control (list-ref s 6))
    (set! current-env (list-ref s 7)) (set! pending (list-ref s 8))
    (set! outcome (list-ref s 9)) (set! steps (list-ref s 10))
    (set! cancellation-requested (list-ref s 11))
    (boundary)))
(values start resume cancel capture restore reject)
